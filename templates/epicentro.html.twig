{% extends '/base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <br><br><br>
        </div>
        <div class="row">
            <div class="col-sm-8">
                <h2 class="mb-4">
                    {% block page_title %}
                        Ciudades cercanas al sismo del <strong>{{ fecha|date("d-m-Y H:i:s ") }} (UTC) </strong>
                        <span class="badge bg-danger">M {{ magnitud|round(1) }} </span>
                    {% endblock %}
                </h2>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">
                    Inicio
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-8">
                <h3 class="mb-4 text-muted">
                    {{ epi }}
                </h3>
            </div>
        </div>

        <div class="row h-100 mt-3">
            <div class="col-12 col-md-5">

                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="cercanas-tab" data-bs-toggle="tab" data-bs-target="#cercanas" type="button" role="tab" aria-controls="cercanas" aria-selected="true">
                            Las 20 más cercanas
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="importantes-tab" data-bs-toggle="tab" data-bs-target="#importantes" type="button" role="tab" aria-controls="importantes" aria-selected="false">
                            Ciudades Importantes
                        </button>
                    </li>
                </ul>

                <div class="tab-content border border-top-0 p-3 bg-white" id="myTabContent">

                    <div class="tab-pane fade show active" id="cercanas" role="tabpanel" aria-labelledby="cercanas-tab">
                        <div class="bs-example table-responsive" data-example-id="contextual-table">
                            <table class="table table-bordered table-hover table-condensed table-sm table-striped w-100" id="tabla_epi_cercanas" style="font-size: 13px !important;">
                                <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Ciudad</th>
                                    <th>Distancia (km)</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for ciudad in ciudades_cercanas %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ ciudad.nombre }}</td>
                                        <td>{{ ciudad.distancia|number_format(2, '.', ',') }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="importantes" role="tabpanel" aria-labelledby="importantes-tab">
                        <div class="bs-example table-responsive" data-example-id="contextual-table">
                            <table class="table table-bordered table-hover table-condensed table-sm table-striped w-100" id="tabla_epi_importantes" style="font-size: 13px !important;">
                                <thead class="table-primary">
                                <tr>
                                    <th>#</th>
                                    <th>Ciudad Importante</th>
                                    <th>Distancia (km)</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for ciudad in ciudades_importantes %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ ciudad.nombre }}</td>
                                        <td>{{ ciudad.distancia|number_format(2, '.', ',') }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-12 col-md-7 d-none d-md-block">
                <div class="row h-100" style="min-height: 500px;">
                    <div id="map" style="width: 100%; height: 100%; border-radius: 8px; box-shadow: 0px 4px 10px rgba(0,0,0,0.1);"></div>
                </div>
            </div>
        </div>

        <br><br><br>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // 1. Inyectamos los arreglos de PHP directo a variables JS en formato JSON
            const latReferencia = {{ lat }};
            const lonReferencia = {{ long }};
            const ciudadesCercanas = {{ ciudades_cercanas|json_encode|raw }};
            const ciudadesImportantes = {{ ciudades_importantes|json_encode|raw }};

            // 2. Configuración general para ambos DataTables
            const dataTableConfig = {
                responsive: true,
                paging: true,
                ordering: true,
                order: [[2, "asc"]],
                lengthMenu: [10, 20, 50],
                pageLength: 10,
                language: {
                    processing: "En curso...",
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ ciudades",
                    infoEmpty: "Mostrando 0 a 0 de 0 ciudades",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    }
                }
            };

            $('#tabla_epi_cercanas').DataTable(dataTableConfig);
            $('#tabla_epi_importantes').DataTable(dataTableConfig);

            // 3. Inicialización del Mapa
            const isDesktopUp = window.matchMedia('(min-width: 768px)').matches;

            if (isDesktopUp) {
                // Instanciar el mapa
                let map = L.map('map').setView([latReferencia, lonReferencia], 8);

                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '&copy; OpenStreetMap contributors',
                }).addTo(map);

                // Icono del Epicentro (Estrella)
                const starIcon = L.divIcon({
                    html: '<img src="{{ asset('assets/imagenes/Estrella_roja.png') }}" alt="Estrella" style="width:50%;">',
                    className: '',
                    iconSize: [80, 80],
                    iconAnchor: [30, 30]
                });

                // Icono para las Ciudades
                const cuadradoIcon = L.divIcon({
                    html: '<div style="width: 10px; height: 10px; background-color: blue; border: 2px solid black; border-radius: 2px;"></div>',
                    className: '',
                    iconSize: [20, 20],
                    iconAnchor: [10, 10]
                });

                // Marcador del Epicentro fijo en el mapa
                L.marker([latReferencia, lonReferencia], {icon: starIcon})
                    .addTo(map)
                    .bindPopup('<strong>Epicentro</strong>');

                // Capa agrupada para administrar fácilmente los marcadores de las ciudades
                let marcadoresCapa = L.layerGroup().addTo(map);

                // Función que dibuja marcadores según el arreglo y ajusta la cámara
                function actualizarMapa(datosCiudades) {
                    marcadoresCapa.clearLayers(); // Borramos marcadores anteriores

                    let puntosBounds = [];
                    // Siempre incluimos el epicentro en los límites de la cámara
                    puntosBounds.push([latReferencia, lonReferencia]);

                    datosCiudades.forEach(ciudad => {
                        let marker = L.marker([ciudad.lat, ciudad.lon], {icon: cuadradoIcon})
                            .bindPopup(`<strong>${ciudad.nombre}</strong><br>Distancia: ${ciudad.distancia.toFixed(2)} km`);

                        marcadoresCapa.addLayer(marker);
                        puntosBounds.push([ciudad.lat, ciudad.lon]);
                    });

                    // Centrar mapa ajustándose a los marcadores dibujados
                    if (puntosBounds.length > 1) {
                        map.fitBounds(puntosBounds, { padding: [30, 30] });
                    }
                }

                // Dibujar el mapa inicial con las "Ciudades Cercanas"
                actualizarMapa(ciudadesCercanas);

                // 4. Listener para las Pestañas (Bootstrap 5)
                // Escucha el evento cuando se cambia de pestaña para cambiar los puntos del mapa
                let tabElements = document.querySelectorAll('button[data-bs-toggle="tab"]');
                tabElements.forEach(function(tab) {
                    tab.addEventListener('shown.bs.tab', function (event) {
                        let tabSeleccionado = event.target.getAttribute('aria-controls');

                        if (tabSeleccionado === 'cercanas') {
                            actualizarMapa(ciudadesCercanas);
                        } else if (tabSeleccionado === 'importantes') {
                            actualizarMapa(ciudadesImportantes);
                        }

                        // Refrescar tamaño del mapa en caso de redibujo UI
                        setTimeout(() => { map.invalidateSize(); }, 100);
                    });
                });
            }
        });
    </script>
{% endblock %}