{% extends '/base.html.twig' %}

{% block body %}

    <div class="container-fluid">

        <div class="row mt-4">
            <div class="col-sm-8">
                <h2 class="mb-4">{% block page_title %}
                    Sismo
                    del <strong>{{ fecha|date("d-m-Y") }}</strong> <span class="badge bg-danger">M {{ magnitud |
                        round(1) }} </span> </h2>
                <h3>
                    Hora: {{ fecha|date("H:i:s ") }}(UTC) -- {{ fecha|date('H:i:s', 'America/Costa_Rica') }} (Local)
                    {% endblock %}
                </h3>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <h4 class="text-muted">{{ epi }}</h4>
                <h4 class="text-muted">Profundidad: {{ profundidad|round(1) }} km</h4>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="bs-example" data-example-id="contextual-table">
                    <table class="table table-bordered table-hover table-striped dt-responsive nowrap" id="tabla_pga" style="width:100%">
                        <thead class="table-dark">
                        <tr>
                            <th style="width: 20%;">Estación</th>
                            <th style="width: 20%;">Tipo Suelo</th>
                            <th style="width: 20%;">Zona</th>
                            <th style="width: 20%;">PGA – aceleración pico del terreno (cm/s²)</th>
                            <th style="width: 30%;">Espectro CSCR</th>
                            <th style="width: 30%;">Espectro</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dato in datos %}
                            <tr>
                                <td class="align-middle fw-bold">{{ dato.nombre }} ({{ dato.estacion }})</td>
                                <td class="align-middle fw-bold">{{ dato.suelo |replace({'S1': 'Roca','s1': 'Roca',
                                        'S2': 'Firme','s2': 'Firme',
                                        'S3': 'Blando', 's3': 'Blando','s4':'Muy Blando','S4':'Muy Blando'})}} </td>
                                <td class="align-middle fw-bold">{{ dato.zona |replace({'zII': 'Zona II (Baja/Media - Caribe)',
                                        'zIII': 'Zona III (Alta - Centro)', 'z4': 'Zona IV (Muy Alta - Pacífico)',
                                        'zIV': 'Zona IV (Muy Alta - Pacífico)'})}} </td>

                                <td class="align-middle">{{ dato.maximo | round(2) }}</td>

                                {# ----- COLUMNA IMAGEN 1 (CSCR) ----- #}
                                <td class="text-center align-middle">
                                    <div class="ratio ratio-16x9 border rounded overflow-hidden estado-proceso"
                                         style="width: 150px; margin: 0 auto;"
                                         onclick="if(this.classList.contains('cargado')) openModal('{{ asset('assets/waves/' ~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}')">

                                        <!-- Aquí está el nuevo span -->
                                        <span class="texto-proceso">En proceso...</span>

                                        <img src="{{ asset('assets/waves/' ~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}"
                                             alt="Previo CSCR"
                                             class="imagen-dinamica"
                                             style="object-fit: cover;"
                                             onload="this.parentElement.classList.remove('estado-proceso'); this.parentElement.classList.add('cargado'); this.classList.add('visible');"
                                             onerror="this.style.display='none';">
                                    </div>

                                </td>

                                {# ----- COLUMNA IMAGEN 2 (Espectro General) ----- #}
                                <td class="text-center align-middle">
                                    <div class="ratio ratio-16x9 border rounded overflow-hidden estado-proceso"
                                         style="width: 150px; margin: 0 auto;"
                                         onclick="if(this.classList.contains('cargado')) openModal('{{ asset('assets/waves/' ~ dato.grafica ~ '_RotD100_loglog.png') }}')">

                                        <!-- Aquí está el nuevo span -->
                                        <span class="texto-proceso">En proceso...</span>

                                        <img src="{{ asset('assets/waves/' ~ dato.grafica ~ '_RotD100_loglog.png') }}"
                                             alt="Previo Espectro"
                                             class="imagen-dinamica"
                                             style="object-fit: cover;"
                                             onload="this.parentElement.classList.remove('estado-proceso'); this.parentElement.classList.add('cargado'); this.classList.add('visible');"
                                             onerror="this.style.display='none';">
                                    </div>

                                </td>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="myModal" class="modal" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body text-center p-0 position-relative">
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" onclick="closeModal()" aria-label="Close"></button>
                        <img class="img-fluid rounded shadow-lg" id="img01" style="max-height: 90vh;">
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Inicialización de DataTable
            let mytabla = $('#tabla_pga').DataTable({
                columnDefs: [
                    { targets: '_all', className: 'dt-head-center dt-body-center' }
                ],
                responsive: true,
                paging: true,
                ordering: true,
                order: [[3, "desc"]], // Ordenar por columna "Máximo" (índice 3 en base 0)
                lengthMenu: [15, 30, 60],
                pageLength: 15,
                language: {
                    processing: "Procesando...",
                    search: "Filtrar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ estaciones",
                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    },
                },
            });
        });

        // Lógica del Modal
        var modal = document.getElementById("myModal");
        var modalImg = document.getElementById("img01");

        function openModal(src) {
            modal.style.display = "block";
            modalImg.src = src;
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.style.display = "none";
            document.body.style.overflow = 'auto';
            modalImg.src = ""; // Limpiar la imagen al cerrar
        }

        window.onclick = function(event) {
            if (event.target == modal) {
                closeModal();
            }
        }
    </script>

    <style>
        .modal {
            background-color: rgba(0,0,0,0.85);
        }

        /* ----- ESTILOS DEL ESTADO "EN PROCESO" ----- */
        .estado-proceso {
            background-color: #e9ecef;
            position: relative;
            cursor: default !important;
        }

        /* El nuevo span de texto */
        .texto-proceso {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 0.8rem;
            font-weight: 600;
            z-index: 10;
        }

        /* Ocultamos el texto automáticamente cuando la imagen se carga */
        .cargado .texto-proceso {
            display: none;
        }

        /* El ::after sigue libre para hacer la animación del brillo */
        .estado-proceso::after {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            background-size: 200% 100%;
            animation: loading-pulse 1.5s infinite linear;
            z-index: 11;
        }

        @keyframes loading-pulse {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* ----- ESTILOS DE LA IMAGEN ----- */
        .imagen-dinamica {
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 20;
            background-color: white;
        }

        .imagen-dinamica.visible {
            opacity: 1;
        }

        /* ----- ESTILOS DE INTERACCIÓN ----- */
        .cargado.ratio:hover {
            opacity: 0.8;
            border-color: #0d6efd !important;
            transition: all 0.2s;
            cursor: pointer;
        }

        .estado-proceso:hover {
            opacity: 1 !important;
            border-color: #dee2e6 !important;
        }

        /* ----- ESTILOS DE INTERACCIÓN ----- */
        /* Solo hacemos hover azul si la imagen ya cargó */
        .cargado.ratio:hover {
            opacity: 0.8;
            border-color: #0d6efd !important;
            transition: all 0.2s;
            cursor: pointer;
        }

        /* Evitamos que el hover afecte a los que están en proceso */
        .estado-proceso:hover {
            opacity: 1 !important;
            border-color: #dee2e6 !important;
        }
    </style>

{% endblock %}