{% extends '/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
{% endblock %}

{% block body %}

    <div class="container-fluid">

        <div class="row mt-4">
            <div class="col-sm-8">
                <h2 class="mb-4">{% block page_title %}
                    Sismo del <strong>{{ fecha|date("d-m-Y") }}</strong>
                    <span class="badge bg-danger">M {{ magnitud | round(1) }} </span>
                </h2>
                <h3>
                    Hora: {{ fecha|date("H:i:s ") }}(UTC) -- {{ fecha|date('H:i:s', 'America/Costa_Rica') }} (Local)
                    {% endblock %}
                </h3>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-12">
                <h4 class="text-muted">{{ epi }}</h4>
                <h4 class="text-muted">Profundidad: {{ profundidad|round(1) }} km</h4>
            </div>
        </div>

        <div class="row">

            <div class="col-lg-4 mb-4">
                <div class="bs-example card shadow-sm p-2 border-0" data-example-id="contextual-table">
                    <table class="table table-bordered table-hover table-striped dt-responsive nowrap table-sm small" id="tabla_pga" style="width:100%">
                        <thead class="table-dark">
                        <tr>
                            <th >Estación</th>
                            <th >Tipo Suelo</th>
                            <th >Zona</th>
                            <th >PGA (cm/s²)</th>
                            <th >Espectro CSCR</th>
                            <th >Espectro</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dato in datos %}
                            <tr>
                                <td class="align-middle ">{{ dato.nombre }} ({{ dato.estacion }})</td>
                                <td class="align-middle ">{{ dato.suelo |replace({'S1': 'Roca','s1': 'Roca', 'S2': 'Firme','s2': 'Firme', 'S3': 'Blando', 's3': 'Blando','s4':'Muy Blando','S4':'Muy Blando'})}} </td>
                                <td class="align-middle ">{{ dato.zona |replace({'zII': 'Zona II', 'zIII': 'Zona III', 'z4': 'Zona IV', 'zIV': 'Zona IV'})}} </td>
                                <td class="align-middle text-center">{{ dato.maximo | round(2) }}</td>

                                {# ----- COLUMNA IMAGEN 1 (CSCR) ----- #}
                                <td class="text-center align-middle">
                                    <div class="ratio ratio-16x9 border rounded overflow-hidden estado-proceso"
                                         style="width: 120px; margin: 0 auto;"
                                         onclick="if(this.classList.contains('cargado')) openModal('{{ asset('assets/waves/' ~id~'/espectros_acc/'~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}')">
                                        <span class="texto-proceso">En proceso...</span>
                                        <img src="{{ asset('assets/waves/'  ~id~'/espectros_acc/'~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}"
                                             alt="Previo CSCR" class="imagen-dinamica" style="object-fit: cover;"
                                             onload="this.parentElement.classList.remove('estado-proceso'); this.parentElement.classList.add('cargado'); this.classList.add('visible');"
                                             onerror="this.style.display='none';">
                                    </div>
                                </td>

                                {# ----- COLUMNA IMAGEN 2 (Espectro General) ----- #}
                                <td class="text-center align-middle">
                                    <div class="ratio ratio-16x9 border rounded overflow-hidden estado-proceso"
                                         style="width: 120px; margin: 0 auto;"
                                         onclick="if(this.classList.contains('cargado')) openModal('{{ asset('assets/waves/' ~id~'/espectros_acc/'~  dato.grafica ~ '_RotD100_loglog.png') }}')">
                                        <span class="texto-proceso">En proceso...</span>
                                        <img src="{{ asset('assets/waves/'  ~id~'/espectros_acc/'~ dato.grafica ~ '_RotD100_loglog.png') }}"
                                             alt="Previo Espectro" class="imagen-dinamica" style="object-fit: cover;"
                                             onload="this.parentElement.classList.remove('estado-proceso'); this.parentElement.classList.add('cargado'); this.classList.add('visible');"
                                             onerror="this.style.display='none';">
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-dark text-white py-2">
                        <h6 class="mb-0 text-center"><i class="bi bi-map"></i> Aceleraciones Espectrales (SA)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="width: 100%; height: 100%; min-height: 500px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"></div>
                    </div>
                </div>
            </div>

        </div>

        <div id="myModal" class="modal" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body text-center p-0 position-relative">
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" onclick="closeModal()" aria-label="Close"></button>
                        <img class="img-fluid rounded shadow-lg" id="img01" style="max-height: 90vh;">
                    </div>
                </div>
            </div>
        </div>

    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // --- INICIALIZACIÓN DE DATATABLES ---
            let dtOptions = {
                columnDefs: [{ targets: '_all', className: 'dt-head-center dt-body-center' }],
                responsive: false, paging: true, ordering: true, order: [[3, "desc"]],
                lengthChange: false, pageLength: 15,
                language: { search: "Buscar:", paginate: { previous: "Anterior", next: "Siguiente" } }
            };

            $('#tabla_pga, #tabla_pgv, #tabla_pgd').DataTable(dtOptions);

            // ==========================================
            // 2. Inicialización del Mapa Leaflet
            // ==========================================
            // Centrado en Costa Rica con zoom 7
            const starIcon = L.divIcon({
                html: '<img src="{{ asset('assets/imagenes/Estrella_roja.png')}}" style="width:40px; height:40px;">',
                className: '', iconSize: [40, 40], iconAnchor: [20, 20]
            });

            const isDesktopUp = window.matchMedia('(min-width: 768px)').matches;
            if (isDesktopUp) {
                map = L.map('map').setView([9.9, -84], 8);
                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}').addTo(map);

                // Epicentro (Fijo)
                L.marker([{{ epi_lat }}, {{ epi_long }}], { icon: starIcon, zIndexOffset: 9999 })
                    .addTo(map)
                    .bindPopup('Epicentro<br> Mag: {{ magnitud | round(1) }}');


                // Ajustar límites
                let bounds = L.latLngBounds([7.5, -86], [11.5, -82.5]);
                map.fitBounds(bounds);
            }

            // Función para determinar el color del marcador según SA Máxima
            function getSaColor(sa) {
                return sa > 100 ? '#cc0000' :
                    sa > 50  ? '#cc5200' :
                        sa > 20  ? '#ccaa00' :
                            sa > 10  ? '#88cc00' :
                                sa > 5   ? '#00cc03' :
                                    '#0058cc';
            }

            // Opciones de estilo para los puntos GeoJSON
            function geojsonMarkerOptions(feature) {
                return {
                    radius: 8,
                    fillColor: getSaColor(feature.properties.sa_max_cm_s2),
                    color: "#000",
                    weight: 1,
                    opacity: 1,
                    fillOpacity: 0.8
                };
            }

            // Crear el PopUp con la información detallada para cada estación
            function onEachFeature(feature, layer) {
                if (feature.properties) {
                    var props = feature.properties;
                    var popupContent = `
                        <div class="text-center" style="min-width: 180px;">
                            <h6 class="fw-bold mb-2 border-bottom pb-1">Estación: ${props.estacion}</h6>
                            <table class="table table-sm table-borderless mb-0 text-start" style="font-size: 12px;">
                                <tr><td class="p-1"><b>SA Max:</b></td><td class="text-end p-1">${props.sa_max_cm_s2} cm/s²</td></tr>
                                <tr><td class="p-1"><b>Periodo Max:</b></td><td class="text-end p-1">${props.periodo_max_s} s</td></tr>
                                <tr><td class="p-1"><b>SA (0.2s):</b></td><td class="text-end p-1">${props.sa_02_cm_s2} cm/s²</td></tr>
                                <tr><td class="p-1"><b>SA (1.0s):</b></td><td class="text-end p-1">${props.sa_10_cm_s2} cm/s²</td></tr>
                            </table>
                        </div>
                    `;
                    layer.bindPopup(popupContent);
                }
            }

            // Consumir el archivo GeoJSON
            // Ajusta la ruta si el archivo está en una carpeta genérica o específica por ID
            var geojsonUrl = "{{ asset('assets/waves/' ~ id ~ '/espectros_acc/datos_espectrales.geojson') }}";

            fetch(geojsonUrl)
                .then(response => {
                    if (!response.ok) throw new Error('GeoJSON no encontrado');
                    return response.json();
                })
                .then(data => {
                    L.geoJSON(data, {
                        pointToLayer: function (feature, latlng) {
                            return L.circleMarker(latlng, geojsonMarkerOptions(feature));
                        },
                        onEachFeature: onEachFeature
                    }).addTo(map);
                })
                .catch(error => {
                    console.warn('No se pudo cargar el mapa de aceleraciones espectrales:', error);
                });
        });

        // ==========================================
        // 3. Lógica del Modal
        // ==========================================
        var modal = document.getElementById("myModal");
        var modalImg = document.getElementById("img01");

        function openModal(src) {
            modal.style.display = "block";
            modalImg.src = src;
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.style.display = "none";
            document.body.style.overflow = 'auto';
            modalImg.src = "";
        }

        window.onclick = function(event) {
            if (event.target == modal) {
                closeModal();
            }
        }
    </script>

    <style>
        .modal {
            background-color: rgba(0,0,0,0.85);
        }

        /* ----- ESTILOS DEL ESTADO "EN PROCESO" ----- */
        .estado-proceso {
            background-color: #e9ecef;
            position: relative;
            cursor: default !important;
        }

        .texto-proceso {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 0.8rem;
            font-weight: 600;
            z-index: 10;
        }

        .cargado .texto-proceso { display: none; }

        .estado-proceso::after {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            background-size: 200% 100%;
            animation: loading-pulse 1.5s infinite linear;
            z-index: 11;
        }

        @keyframes loading-pulse {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* ----- ESTILOS DE LA IMAGEN ----- */
        .imagen-dinamica {
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 20;
            background-color: white;
        }

        .imagen-dinamica.visible { opacity: 1; }

        /* ----- ESTILOS DE INTERACCIÓN ----- */
        .cargado.ratio:hover {
            opacity: 0.8;
            border-color: #0d6efd !important;
            transition: all 0.2s;
            cursor: pointer;
        }

        .estado-proceso:hover {
            opacity: 1 !important;
            border-color: #dee2e6 !important;
        }
    </style>
{% endblock %}