{% extends '/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
{% endblock %}

{% block body %}

    <div class="container-fluid">

        <div class="row mt-4">
            <div class="col-sm-8">
                <h2 class="mb-4">{% block page_title %}
                    Sismo del <strong>{{ fecha|date("d-m-Y") }}</strong>
                    <span class="badge bg-danger">M {{ magnitud | round(1) }} </span>
                </h2>
                <h3>
                    Hora: {{ fecha|date("H:i:s ") }}(UTC) -- {{ fecha|date('H:i:s', 'America/Costa_Rica') }} (Local)
                    {% endblock %}
                </h3>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-sm-12">
                <h4 class="text-muted">{{ epi }}</h4>
                <h4 class="text-muted">Profundidad: {{ profundidad|round(1) }} km</h4>
            </div>
        </div>

        <div class="row">
            <!-- DIV de la TABLA-->
            <div class="col-lg-5 mb-4">
                <div class="bs-example card shadow-sm p-2 border-0" data-example-id="contextual-table">
                    <table class="table table-bordered table-hover table-striped dt-responsive nowrap table-sm small" id="tabla_pga" style="width:100%">
                        <thead class="table-dark">
                        <tr>
                            <th hidden>order</th>
                            <th >Estación</th>
                            <th >Tipo Suelo</th>
                            <th >Zona</th>
                            <th >Aceleraciones</th>
                            <th hidden>Espectro CSCR</th>
                            <th >Gr&aacute;ficas</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dato in datos %}
                            <tr>
                                <td  hidden class="align-middle " >{{ dato.max }}</td>
                                <td class="align-middle ">{{ dato.nombre }} ({{ dato.estacion }})</td>
                                <td class="align-middle ">{{ dato.suelo |replace({'S1': 'Roca','s1': 'Roca', 'S2': 'Firme','s2': 'Firme', 'S3': 'Blando', 's3': 'Blando','s4':'Muy Blando','S4':'Muy Blando'})}} </td>
                                <td class="align-middle ">{{ dato.zona |replace({'zII': 'Zona II', 'zIII': 'Zona III', 'z4': 'Zona IV', 'zIV': 'Zona IV'})}} </td>
                                <td class="align-middle"  style="font-size: 12px;">
                                    <strong>SA Max:</strong> {{ dato.max|round(2) }} (cm/s²) <br/>
                                    <strong>Periodo Max:</strong> {{ dato.periodo }} s<br/>
                                    <strong>SA para 0.2s:</strong> {{ dato.sa_02 }} (cm/s²)<br/>
                                    <strong>SA para 1.0s:</strong> {{ dato.sa_10 }} (cm/s²)<br/>
                                </td>

                                {# ----- COLUMNA 1: Botón para CSCR (1 Imagen) ----- #}
                                <td hidden class="text-center align-middle">
                                    <button type="button" class="btn btn-outline-primary btn-sm shadow-sm"
                                            onclick="openSingleModal('{{ asset('assets/waves/' ~ id ~ '/espectros_acc/' ~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}')">
                                        <i class="bi bi-image"></i> Ver CSCR
                                    </button>
                                </td>

                                {# ----- COLUMNA 2: Botón para Espectros (Carrusel de 3 Imágenes) ----- #}
                                <td class="text-center align-middle">
                                    <button type="button" class="btn btn-outline-info btn-sm shadow-sm"
                                            onclick="openCarouselModal([
                                                    '{{ asset('assets/waves/' ~ id ~ '/espectros_acc/' ~ dato.grafica ~ '_RotD100_loglog_CSCR.png') }}',
                                                    '{{ asset('assets/waves/' ~ id ~ '/espectros_acc/' ~ dato.grafica ~ '_RotD100_loglog.png') }}',
                                                    '{{ asset('assets/waves/' ~ id ~ '/espectros_acc/' ~ dato.grafica ~ '_vel.png') }}',
                                                    '{{ asset('assets/waves/' ~ id ~ '/espectros_acc/' ~ dato.grafica ~ '_disp.png') }}'
                                                    ])">
                                        <i class="bi bi-images"></i> Ver
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- DIV del MAPA-->
            <div class="col-lg-7 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-dark text-white py-2">
                        <h6 class="mb-0 text-center"><i class="bi bi-map"></i> Aceleraciones Espectrales Máximas (SA)</h6>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="width: 100%; height: 100%; min-height: 500px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"></div>
                    </div>
                </div>
            </div>

        </div>

        <div class="modal fade" id="singleImageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body text-center p-0 position-relative">
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 1055;"></button>
                        <img class="img-fluid rounded shadow-lg bg-white" id="singleModalImg" style="max-height: 90vh;">
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="carouselImageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content bg-transparent border-0 position-relative">

                    <button type="button" data-bs-dismiss="modal" aria-label="Close"
                            style="position: absolute; top: 15px; right: 15px; z-index: 9999;
                           width: 40px; height: 40px; background-color: rgba(0,0,0,0.7);
                           border: 2px solid white; border-radius: 50%; color: white;
                           font-size: 20px; font-weight: bold; display: flex;
                           align-items: center; justify-content: center;
                           padding: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
                        &#10005; </button>

                    <div id="espectrosCarousel" class="carousel slide bg-white rounded shadow-lg pt-2 pb-4" data-bs-theme="dark">

                        <div class="carousel-indicators" id="carousel-indicators-container" style="margin-bottom: -15px;"></div>

                        <div class="carousel-inner rounded px-5" id="carousel-inner-container"></div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#espectrosCarousel" data-bs-slide="prev" style="width: 5%;">
                            <span class="carousel-control-prev-icon bg-dark rounded-circle p-2 shadow-sm" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#espectrosCarousel" data-bs-slide="next" style="width: 5%;">
                            <span class="carousel-control-next-icon bg-dark rounded-circle p-2 shadow-sm" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- MODAL PARA LA LEYENDA DEL MAPA-->
    <div class="modal fade" id="modalLeyenda" tabindex="-1" aria-labelledby="modalLeyendaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="modalLeyendaLabel">
                        <i class="bi bi-info-circle-fill me-2"></i><span id="textoTituloModal">Descripción de la Escala</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-light" id="modalLeyendaCuerpo">
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var basePath = "{{ asset('assets/waves/' ~ id ~ '/espectros_acc/') }}";
            // Consumir el archivo GeoJSON
            // Ajusta la ruta si el archivo está en una carpeta genérica o específica por ID
            var geojsonUrl = "{{ asset('assets/waves/' ~ id ~ '/espectros_acc/datos_espectrales.geojson') }}";
            //alert(geojsonUrl);

            // --- INICIALIZACIÓN DE DATATABLES ---
            let dtOptions = {
                // 1. Fundamental: Apagar el auto-ajuste para que respete tus anchos
                autoWidth: false,

                columnDefs: [
                    // Regla general: Centrado y aplicamos una clase para el texto pequeño
                    {
                        targets: '_all',
                        className: 'dt-head-center dt-body-center texto-pequeno'
                    },
                    // Regla específica: Le damos el mayor porcentaje de ancho a tu columna objetivo
                    {
                        targets: 4, // Cambia este número si la columna es otra (Ej: 3 para PGA)
                        width: '35%' // Toma el 35% del espacio total
                    },
                    // Opcional: Forzar a las otras columnas a ser más pequeñas
                    { targets: [0, 1, 2, 3], width: '10%' },
                    { targets: [5, 6], width: '12%' }
                ],

                responsive: false,
                paging: true,
                ordering: true,
                order: [[0, "desc"]],
                lengthChange: false,
                pageLength: 10,
                language: {
                    search: "Buscar:",
                    paginate: { previous: "Anterior", next: "Siguiente" }
                }
            };

            $('#tabla_pga, #tabla_pgv, #tabla_pgd').DataTable(dtOptions);
            // ==========================================
            // 2. Inicialización del Mapa Leaflet
            // ==========================================
            // Centrado en Costa Rica con zoom 7
            const starIcon = L.divIcon({
                html: '<img src="{{ asset('assets/imagenes/Estrella_roja.png')}}" style="width:40px; height:40px;">',
                className: '', iconSize: [40, 40], iconAnchor: [20, 20]
            });

            const isDesktopUp = window.matchMedia('(min-width: 768px)').matches;
            if (isDesktopUp) {
                map = L.map('map').setView([9.9, -84], 8);
                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}').addTo(map);

                // Epicentro (Fijo)
                L.marker([{{ epi_lat }}, {{ epi_long }}], { icon: starIcon, zIndexOffset: 9999 })
                    .addTo(map)
                    .bindPopup('Epicentro<br> Mag: {{ magnitud | round(1) }}');


                // Ajustar límites
                let bounds = L.latLngBounds([7.5, -86], [11.5, -82.5]);
                map.fitBounds(bounds);
            }

            // Función para determinar el color del marcador según SA Máxima
            function getSaColor(sa) {
                return sa > 500 ? '#cc0000' :
                    sa > 200  ? '#cc5200' :
                        sa > 100  ? '#cc8b00' :
                            sa > 50  ? '#ccaa00' :
                                sa > 10   ? '#88cc00' :
                                    sa > 2   ? '#00cc03' :
                                                '#0058cc';
            }


            // Definición de rangos en el mismo orden que el getColor
            const legendItems = [
                { label: '> 500',  color: '#cc0000' },
                { label: '200 – 500', color: '#cc5200' },
                { label: '100 – 200', color: '#cc8b00' },
                { label: '50 – 100', color: '#ccaa00' },
                { label: '10 – 50', color: '#88cc00' },
                { label: '2 – 10', color: '#00cc03' },
                { label: '≤ 2', color: '#0058cc' },
            ];

            // Control de Leaflet para la leyenda
            const legend = L.control({ position: 'topright' });

            legend.onAdd = function () {
                // Si estás usando Bootstrap, puedes agregar clases al div principal: 'info legend bg-white p-2 shadow rounded'
                const div = L.DomUtil.create('div', 'info legend');

                // Estilos del contenedor (puedes omitirlos si ya los manejas en tu CSS)
                div.style.backgroundColor = 'white';
                div.style.padding = '10px';
                div.style.borderRadius = '5px';
                div.style.boxShadow = '0 0 15px rgba(0,0,0,0.2)';
                div.style.cursor = 'pointer'; // Cambia el cursor a la "manito"
                div.title = 'Haz clic para ver la descripción detallada'; // Tooltip nativo al pasar el mouse

                div.innerHTML = '<div class="legend-title" style="font-weight:bold; margin-bottom:8px;">Escala (S.A.)<br/>(cm/s²)</div>';

                legendItems.forEach(item => {
                    // Se reemplazó legendTriangle() por un elemento <i> con border-radius: 50%
                    div.innerHTML += `
            <div class="legend-item" style="display: flex; align-items: center; margin-bottom: 4px;">
                <i style="background: ${item.color}; width: 14px; height: 14px; border-radius: 50%; display: inline-block; margin-right: 8px; border: 1px solid #333; opacity: 0.8;"></i>
                <span>${item.label}</span>
            </div>`;
                });

                L.DomEvent.disableClickPropagation(div);

                // 4. Agregar el evento clic
                div.addEventListener('click', function() {

                    // Referencias a las partes del modal que vamos a modificar
                    const tituloModal = document.getElementById('textoTituloModal');
                    const cuerpoModal = document.getElementById('modalLeyendaCuerpo');

                    let htmlCuerpo = `
                        <table class="table table-sm table-striped table-borderless mb-0">
                            <tbody>
                                <tr><td class="fw-bold text-nowrap" style="color:#0058cc;">&lt; 2</td><td>Imperceptible </td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#00cc03;">2 – 10</td><td>Perceptible </td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#88cc00;">10 – 50</td><td>Movimiento claramente apreciable</td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#ccaa00;">50 – 100</td><td>Movimiento fuerte</td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#cc8b00;">100 – 200</td><td>Posibles daños no estructurales</td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#cc5200;">200 – 500</td><td>Posibles daños estructurales moderados</td></tr>
                                <tr><td class="fw-bold text-nowrap" style="color:#cc0000;">&gt; 500</td><td>Daño severo esperado</td></tr>
                            </tbody>
                        </table>
                    `;
                    let textoTitulo = 'Escala Aceleración (cm/s²)';

                    // Inyectar los datos en el modal
                    tituloModal.textContent = textoTitulo;
                    cuerpoModal.innerHTML = htmlCuerpo;

                    // Instanciar y mostrar el modal usando el JS de Bootstrap 5
                    const modalElement = document.getElementById('modalLeyenda');
                    const modalInstancia = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modalInstancia.show();
                });


                return div;
            };

            legend.addTo(map);


            // Opciones de estilo para los puntos GeoJSON
            function geojsonMarkerOptions(feature) {
                return {
                    radius: 8,
                    fillColor: getSaColor(feature.properties.sa_max_cm_s2),
                    color: "#000",
                    weight: 1,
                    opacity: 1,
                    fillOpacity: 0.8
                };
            }

            // Crear el PopUp con la información detallada para cada estación
            function onEachFeature(feature, layer) {

                if (feature.properties) {
                    var props = feature.properties;
                    var popupContent = `
                        <div class="text-center" style="min-width: 180px;">
                            <h6 class="fw-bold mb-2 border-bottom pb-1">Estación: ${props.estacion}</h6>
                            <table class="table table-sm table-borderless mb-0 text-start" style="font-size: 12px;">
                                <tr><td class="p-1"><b>SA Max:</b></td><td class="text-end p-1">${props.sa_max_cm_s2} cm/s²</td></tr>
                                <tr><td class="p-1"><b>Periodo Max:</b></td><td class="text-end p-1">${props.periodo_max_s} s</td></tr>
                                <tr><td class="p-1"><b>SA (0.2s):</b></td><td class="text-end p-1">${props.sa_02_cm_s2} cm/s²</td></tr>
                                <tr><td class="p-1"><b>SA (1.0s):</b></td><td class="text-end p-1">${props.sa_10_cm_s2} cm/s²</td></tr>

                            </table>
                        </div>
                        <button type="button" class="btn btn-outline-info btn-sm shadow-sm"
                            onclick='openCarouselModal([
                                "${basePath}${props.nombre_archivo}_RotD100_loglog_CSCR.png",
                                "${basePath}${props.nombre_archivo}_RotD100_loglog.png",
                                "${basePath}${props.nombre_archivo}_vel.png",
                                "${basePath}${props.nombre_archivo}_disp.png"
                            ])'>
                            <i class="bi bi-images"></i> Ver Espectros
                        </button>
                    `;
                    layer.bindPopup(popupContent);
                }
            }



            fetch(geojsonUrl)
                .then(response => {
                    if (!response.ok) throw new Error('GeoJSON no encontrado');
                    return response.json();
                })
                .then(data => {
                    // Verificamos que existan features y las ordenamos de menor a mayor
                    if (data && data.features) {
                        data.features.sort(function(a, b) {
                            // Restar el valor 'b' del valor 'a' ordena ascendentemente
                            return a.properties.sa_max_cm_s2 - b.properties.sa_max_cm_s2;
                        });
                    }

                    L.geoJSON(data, {
                        pointToLayer: function (feature, latlng) {
                            return L.circleMarker(latlng, geojsonMarkerOptions(feature));
                        },
                        onEachFeature: onEachFeature
                    }).addTo(map);
                })
                .catch(error => {
                    console.warn('No se pudo cargar el mapa de aceleraciones espectrales:', error);
                });
        });

        // ==========================================
        // Lógica de Modales (Imagen Simple y Carrusel)
        // ==========================================

        function openSingleModal(src) {
            // Asignar imagen y mostrar el modal usando Bootstrap
            document.getElementById('singleModalImg').src = src;
            const modalInstance = new bootstrap.Modal(document.getElementById('singleImageModal'));
            modalInstance.show();
        }

        function openCarouselModal(imagesArray) {
            const innerContainer = document.getElementById('carousel-inner-container');
            const indicatorsContainer = document.getElementById('carousel-indicators-container');

            // Limpiar el carrusel anterior
            innerContainer.innerHTML = '';
            indicatorsContainer.innerHTML = '';

            // Inyectar las nuevas imágenes
            imagesArray.forEach((src, index) => {
                const activeClass = index === 0 ? 'active' : '';

                // Agregar los botones indicadores de abajo
                indicatorsContainer.innerHTML += `
            <button type="button" data-bs-target="#espectrosCarousel" data-bs-slide-to="${index}" class="${activeClass}" aria-label="Slide ${index + 1}"></button>
        `;

                // Agregar la imagen al carrusel
                innerContainer.innerHTML += `
            <div class="carousel-item ${activeClass}">
                <img src="${src}" class="d-block w-100 img-fluid" style="max-height: 85vh; object-fit: contain;" alt="Espectro ${index + 1}">
            </div>
        `;
            });

            // Mostrar el modal
            const modalInstance = new bootstrap.Modal(document.getElementById('carouselImageModal'));
            modalInstance.show();
        }



    </script>

    <style>
        .modal {
            background-color: rgba(0,0,0,0.85);
        }

        .texto-pequeno {
            font-size: 12px !important; /* Ajusta a 11px o 13px según lo necesites */
        }
    </style>
{% endblock %}