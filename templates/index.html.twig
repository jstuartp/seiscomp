{% extends '/base.html.twig' %}

{% block head_extra %}
    <meta http-equiv="refresh" content="1800">
    <style>
        /* Contenedor de la columna izquierda con scroll independiente */
        .cards-pane {
            height: calc(100vh - 200px);
            overflow: auto;
        }
        /* Altura del mapa en escritorio */
        #map { height: calc(100vh - 200px); }
        .card-header button { text-align: left; width: 100%; }
        .badge-mag { min-width: 3.2rem; }
        .card-hover:hover { background: #f8fbff; }
    </style>
{% endblock %}

{% block body %}

    <script>
        function enviaDatos (id, fecha, mag, lat, long_, informe, epi) {
            var theForm = document.createElement('form');
            theForm.action = '{{ path('informe') }}';
            theForm.method = 'post';
            function add(name, value){ const i = document.createElement('input'); i.type='hidden'; i.name=name; i.value=value; theForm.appendChild(i); }
            add('id', id); add('fecha', fecha); add('mag', mag); add('lat', lat); add('long', long_); add('informe', informe); add('epi', epi);
            document.body.appendChild(theForm); theForm.submit();
        }
    </script>

    <div class="container-fluid">
        <div class="row mt-3">
            <h2 class="text-center my-3">
                <a href="{{ path('homepage', {'tipo': 1}) }}"
                   class="badge rounded-pill {% if tipo == 1 %}text-bg-danger{% else %}text-bg-secondary{% endif %}">
                    Sismos con Informe
                </a>

                <a href="{{ path('homepage', {'tipo': 2}) }}"
                   class="badge rounded-pill {% if tipo == 2 %}text-bg-primary{% else %}text-bg-secondary{% endif %}">
                    Todos los Sismos
                </a>
            </h2>

        </div>

        <div class="row g-3 mt-2">
            {# IZQUIERDA: tarjetas colapsables (accordion), una por sismo #}
            <div class="col-12 col-md-3">
                <div id="sismosAccordion" class="accordion cards-pane">
                    {% for dato in datos|slice(0,20) %}
                        {% set _id = 'evt_' ~ (dato.idEvento|default(loop.index)) %}
                        <div class="accordion-item card-hover" data-lat="{{ dato.latitudEvento|default('') }}"
                             data-lon="{{ dato.longitudEvento|default('') }}" data-mag="{{ dato.magnitudEvento|default('') }}"
                             data-epi="{{ dato.epi|default('Epicentro no disponible') }}" data-id="{{ dato.idEvento }}"
                             data-fecha="{{ dato.fechaEvento|date("d/m/Y H:i:s")  }}"
                                data-fecha-cr="{{ dato.fechaEvento|date("d/m/Y H:i:s", "America/Costa_Rica")  }}">
                            <h2 class="accordion-header" id="heading_{{ _id }}">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_{{ _id }}" aria-expanded="false" aria-controls="collapse_{{ _id }}">
                                    <div class="w-100 d-flex align-items-center justify-content-between">
                                        <div class="me-2">
                                            <div class="fw-semibold">{{ dato.epi|default('Epicentro no disponible') }}</div>
                                            <small class="text-muted">{{ dato.fechaEvento|default('')|date("d/m/Y H:i:s") }} UTC</small><br>
                                            <small class="text-muted">{{ dato.fechaEvento|date("d/m/Y H:i:s", "America/Costa_Rica") }} Local</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge text-bg-danger badge-mag">M {{ '%.1f'|format((dato.magnitudEvento|default(0))|round(1)) }}</span>
                                            {% set pga = dato.aceleracionEvento is defined ? dato.aceleracionEvento : (dato.pga is defined ? dato.pga : null) %}
                                            {% if pga is not null %}
                                                <div><small class="text-muted">PGA {{ pga|round(2) }} cm/s²</small></div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse_{{ _id }}" class="accordion-collapse collapse" aria-labelledby="heading_{{ _id }}" data-bs-parent="#sismosAccordion">
                                <div class="accordion-body">
                                    <div class="row g-2">
                                        <div class="col-6"><small class="text-muted">Lat</small><div>{{ dato.latitudEvento|default('') }}</div></div>
                                        <div class="col-6"><small class="text-muted">Lon</small><div>{{ dato.longitudEvento|default('') }}</div></div>
                                        <div class="col-6"><small class="text-muted">Profundidad (m)</small><div>{{ '%.1f'|format((dato.profundidadEvento|default(0)) == 0 ? 5 : (dato.profundidadEvento|default(0))|round(1)) }}</div></div>
                                    </div>
                                    <div class="mt-3 d-flex gap-2">
                                        <button class="btn btn-sm btn-primary" onclick="enviaDatos('{{ dato.idEvento|default('') }}','{{ dato.fechaEvento|default('') }}','{{ dato.magnitudEvento|default('') }}','{{ dato.latitudEvento|default('') }}','{{ dato.longitudEvento|default('') }}','{{ dato.informe|default('') }}','{{ dato.epi|default('') }}')">Mostrar detalle</button>
                                        <button class="btn btn-sm btn-outline-secondary btn-centrar" data-lat="{{ dato.latitudEvento|default('') }}" data-lon="{{ dato.longitudEvento|default('') }}">Centrar en mapa</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# DERECHA: mapa (Leaflet) #}
            <div class="col-12 col-md-9">
                <div id="map" class="w-100">MAPA</div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inicializar el mapa en Costa Rica (bounds aproximados)
            var map = L.map('map').setView([9.75, -84.0], 7);
            var bounds = L.latLngBounds([7.886, -84.409], [11.019, -82.976]);
            map.fitBounds(bounds);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
            L.control.scale().addTo(map);

            // Crear marcadores desde los items del accordion
            const items = document.querySelectorAll('#sismosAccordion .accordion-item');
            const markers = [];
            items.forEach((it, idx) => {
                const lat = parseFloat(it.getAttribute('data-lat'));
                const lon = parseFloat(it.getAttribute('data-lon'));
                const mag = parseFloat(it.getAttribute('data-mag'));
                const fecha = it.getAttribute('data-fecha') || '';
                const epi = it.getAttribute('data-epi') || '';
                const pga = it.getAttribute('data-pga') || '';
                const id = it.getAttribute('data-id') || '';
                const fechaCR = it.getAttribute('data-fecha-cr') || '';
                if (!isNaN(lat) && !isNaN(lon)) {
                    const m = L.circleMarker([lat, lon], { radius: 8, color: '#0033cc', fillColor: '#3399ff', fillOpacity: 1, weight: 2 }).addTo(map);
                    // Popup con datos y botón "Ver informe"
                    const magTxt = isNaN(mag) ? '' : mag.toFixed(1);
                    const pgaTxt = pga !== '' && !isNaN(parseFloat(pga)) ? Number(pga).toFixed(2) + ' cm/s²' : '';
                    const popupHtml = `
<div style="min-width:240px">
<div><strong>${epi || 'Epicentro no disponible'}</strong></div>
<div><small>${fecha.toString()} UTC -- ${fechaCR.toLocaleString()} Local</small></div>
<div>Magnitud: <strong>${magTxt}</strong></div>
${pgaTxt ? `<div>Máx. aceleración: <strong>${pgaTxt}</strong></div>` : ''}
<div class="mt-2">
<button class="btn btn-sm btn-primary" onclick="enviaDatos('${id}','${fecha}','${mag}','${lat}','${lon}','1','${epi}')">Ver informe</button>
</div>
</div>`;
                    m.bindPopup(popupHtml);
                    m.on('mouseover', function(){ this.setStyle({ color:'#cc0000', fillColor:'#ff3333', weight:3 }); });
                    m.on('mouseout',  function(){ this.setStyle({ color:'#0033cc', fillColor:'#3399ff', weight:2 }); });

                    markers[idx] = m;
                } else { markers[idx] = null; }
            });

            // Vincular hover del header de cada card al marcador correspondiente
            const headers = document.querySelectorAll('#sismosAccordion .accordion-header');
            headers.forEach((h, idx) => {
                h.addEventListener('mouseenter', () => { if (markers[idx]) markers[idx].setStyle({ color:'#cc0000', fillColor:'#ff3333', weight:3 }); });
                h.addEventListener('mouseleave', () => { if (markers[idx]) markers[idx].setStyle({ color:'#0033cc', fillColor:'#3399ff', weight:2 }); });
            });

            // Botón "Centrar en mapa" de cada card
            document.querySelectorAll('.btn-centrar').forEach((btn) => {
                btn.addEventListener('click', function(){
                    const lat = parseFloat(this.getAttribute('data-lat'));
                    const lon = parseFloat(this.getAttribute('data-lon'));
                    if (!isNaN(lat) && !isNaN(lon)) {
                        map.setView([lat, lon], 10);
                    }
                });
            });

            // Opcional: centrar al expandir una card
            document.querySelectorAll('#sismosAccordion .accordion-button').forEach((btn, idx) => {
                btn.addEventListener('click', function(){
                    const it = btn.closest('.accordion-item');
                    const lat = parseFloat(it.getAttribute('data-lat'));
                    const lon = parseFloat(it.getAttribute('data-lon'));
                    if (!isNaN(lat) && !isNaN(lon)) {
                        setTimeout(() => map.setView([lat, lon], 10), 250);
                    }
                });
            });

            // Recalcular tamaño del mapa tras posibles reflows
            setTimeout(() => map.invalidateSize(), 250);
            window.addEventListener('resize', () => { setTimeout(() => map.invalidateSize(), 150); });
        });
    </script>

{% endblock %}
