{% extends 'base.html.twig' %}

{% block title %}Sismogramas - {{ estructura.nombre_edificio }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2>Sismogramas: {{ estructura.nombre_edificio }}</h2>
        <span class="fw-semibold">Sismo del {{ fecha|date("d-m-Y H:i:s ") }} con epicentro  {{ epi }} </span>
        <span class="badge bg-danger">M {{ magnitud |round(1)}} </span>

        <div class="row">
            {% for grafica in graficas %}
                {# Usamos grafica.grafica como nombre base del archivo, asumiendo que no tiene extensión #}
                {% set base_file = grafica.rutaWaveform %}

                <div class="col-12 mb-5">
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Estación: {{ grafica.estacion }}</h5>
                        </div>

                        <div class="card-body">
                            {# Pestañas de navegación #}
                            <ul class="nav nav-tabs" id="tabs-{{ loop.index }}" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active btn-plot" data-bs-toggle="tab" data-bs-target="#acc-{{ loop.index }}" type="button" role="tab"
                                            data-url="{{ asset('assets/waves/' ~ id ~'/edificio/'~ base_file ~ '_ACC.json') }}"
                                            data-target="plot-acc-{{ loop.index }}" data-unit="cm/s²" data-title="Aceleración">
                                        Aceleración
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link btn-plot" data-bs-toggle="tab" data-bs-target="#vel-{{ loop.index }}" type="button" role="tab"
                                            data-url="{{ asset('assets/waves/'~ id ~'/edificio/'~ base_file ~ '_VEL.json') }}"
                                            data-target="plot-vel-{{ loop.index }}" data-unit="cm/s" data-title="Velocidad">
                                        Velocidad
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link btn-plot" data-bs-toggle="tab" data-bs-target="#disp-{{ loop.index }}" type="button" role="tab"
                                            data-url="{{ asset('assets/waves/' ~ id ~'/edificio/' ~ base_file ~ '_DISP.json') }}"
                                            data-target="plot-disp-{{ loop.index }}" data-unit="cm" data-title="Desplazamiento">
                                        Desplazamiento
                                    </button>
                                </li>
                            </ul>

                            {# Contenido de las pestañas (Los contenedores para Plotly) #}
                            <div class="tab-content border border-top-0 p-3" id="tabContent-{{ loop.index }}">
                                <div class="tab-pane fade show active" id="acc-{{ loop.index }}" role="tabpanel">
                                    <div id="plot-acc-{{ loop.index }}" style="width:100%; height:400px;">
                                        <div class="text-center mt-5"><div class="spinner-border text-primary" role="status"></div><p>Cargando datos...</p></div>
                                    </div>
                                </div>
                                <div class="tab-pane fade" id="vel-{{ loop.index }}" role="tabpanel">
                                    <div id="plot-vel-{{ loop.index }}" style="width:100%; height:400px;"></div>
                                </div>
                                <div class="tab-pane fade" id="disp-{{ loop.index }}" role="tabpanel">
                                    <div id="plot-disp-{{ loop.index }}" style="width:100%; height:400px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
{% block endscrips %}
    {{ parent() }}
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {

        // Función asíncrona para descargar JSON y dibujar la gráfica
        async function loadAndPlot(url, containerId, title, unit) {
            const container = document.getElementById(containerId);

            try {
                // Mostrar spinner (opcional) si está vacío
                //if (container.innerHTML === "") {
                //    container.innerHTML = '<div class="text-center mt-5"><div class="spinner-border text-primary" role="status"></div><p>Cargando datos...</p></div>';
                //}

                // Descargar el archivo JSON crudo generado por tu script de Python
                const response = await fetch(url);
                if (!response.ok) throw new Error("No se encontró el archivo JSON");
                const payload = await response.json();

                // Magia Sismológica: Crear el eje X (Tiempo en segundos)
                // Sabemos el sample_rate (ej. 200) y npts (ej. 7000)
                const dt = 1.0 / payload.meta.sample_rate;
                const timeArray = Array.from({ length: payload.meta.npts }, (_, i) => i * dt);

                // Preparar los 3 trazos para Plotly
                const traces = [];
                const colores = { 'HNN': 'red', 'HNE': 'blue', 'HNZ': 'green' };

                for (const [canal, datos] of Object.entries(payload.data)) {
                    traces.push({
                        x: timeArray,
                        y: datos,
                        type: 'scatter',
                        mode: 'lines',
                        name: canal,
                        line: { color: colores[canal] || 'black', width: 1 }
                    });
                }

                // Configurar el diseño (Layout)
                const layout = {
                    title: `${title} - Estación: ${payload.meta.station}`,
                    xaxis: { title: 'Tiempo (segundos)', showgrid: true },
                    yaxis: { title: `Amplitud (${unit})`, showgrid: true },
                    hovermode: 'x unified', // Muestra los 3 valores al pasar el mouse
                    margin: { l: 60, r: 20, t: 40, b: 40 },
                    legend: { orientation: "h", y: -0.2 } // Leyenda horizontal abajo
                };

                // Dibujar la gráfica (Plotly reemplazará el spinner automáticamente)
                container.innerHTML = '';
                Plotly.newPlot(containerId, traces, layout, {responsive: true});

            } catch (error) {
                console.error("Error cargando la gráfica:", error);
                container.innerHTML = `<div class="alert alert-danger">Error cargando los datos de ${title}. ¿Ya fueron procesados?</div>`;
            }
        }

        // --- Lógica de Interfaz ---

        // 1. Al cargar la página, dibujar automáticamente la pestaña "Aceleración" de todas las estaciones
        document.querySelectorAll('.tab-pane.active .spinner-border').forEach(spinner => {
            // Buscar el botón correspondiente a esta pestaña para obtener los atributos data-*
            const targetId = spinner.closest('.tab-pane').id;
            const btn = document.querySelector(`button[data-bs-target="#${targetId}"]`);
            if(btn) {
                loadAndPlot(btn.dataset.url, btn.dataset.target, btn.dataset.title, btn.dataset.unit);
            }
        });

        // 2. Escuchar clics en el resto de pestañas para dibujar a demanda (Lazy Load)
        const triggerTabList = document.querySelectorAll('.btn-plot');
        triggerTabList.forEach(triggerEl => {
            triggerEl.addEventListener('click', function (event) {
                const btn = event.target;
                const container = document.getElementById(btn.dataset.target);

                // Si el contenedor no tiene un SVG de plotly adentro, significa que no se ha cargado aún
                if (!container.querySelector('.js-plotly-plot')) {
                    loadAndPlot(btn.dataset.url, btn.dataset.target, btn.dataset.title, btn.dataset.unit);
                }
            });
        });
    });
</script>
{% endblock %}
