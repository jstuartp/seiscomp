{% extends '/base.html.twig' %}

{% block head_extra %}
    <meta http-equiv="refresh" content="1800">
    <style>
        /* ====== Layout general ====== */
        .lis-layout { min-height: 100vh; }

        /* Estilos utilitarios previos */
        .card-header button { text-align: left; width: 100%; }
        .badge-mag { min-width: 3.2rem; }
        .card-hover:hover { background: #f8fbff; }
    </style>
{% endblock %}

{% block body %}

    <script>
        //Activa formas de onda
        function abrirFormasOnda(id, fecha, mag, epi, estructuraid,estructuraNombre) {
            //alert('Abrir Formas de Onda');
            var theForm = document.createElement('form');
            theForm.action = '{{ path('formasonda') }}';
            theForm.method = 'post';
            function add(name, value){ const i = document.createElement('input'); i.type='hidden'; i.name=name; i.value=value; theForm.appendChild(i); }
            add('id', id); add('fecha', fecha); add('mag', mag); add('epi', epi); add('estructuraid', estructuraid);add('estructuraNombre', estructuraNombre)
            document.body.appendChild(theForm); theForm.submit();

            // Aquí puedes cargar un modal, hacer fetch(), cambiar vista, etc.
        }

        //Activa espectros
        function abrirEspectros() {
            alert('Abrir Espectros');
        }

        //Activa Fourier
        function abrirFourier(id, fecha, mag, epi, estructuraid,estructuraNombre) {
            //alert('Abrir Espectro de Fourier');
            var theForm = document.createElement('form');
            theForm.action = '{{ path('espectrosF') }}';
            theForm.method = 'post';
            function add(name, value){ const i = document.createElement('input'); i.type='hidden'; i.name=name; i.value=value; theForm.appendChild(i); }
            add('id', id); add('fecha', fecha); add('mag', mag); add('epi', epi); add('estructuraid', estructuraid);add('estructuraNombre', estructuraNombre)
            document.body.appendChild(theForm); theForm.submit();
        }

        //Activa cocientes
        function abrirCocientes() {
            alert('Abrir Cocientes Espectrales');
        }

    </script>
    <div class="container-fluid">

        {# FILA SUPERIOR: col 1 (izquierda) + col 2 (derecha) #}
        <div class="row  align-items-stretch">
            <div class="col-12 col-lg-4">
                <div class="  d-flex  text-muted">
                    <span class="fw-semibold">Estructura: {{ estructura.nombre_edificio }}, {{ estructura.provincia }}
                    , {{ estructura.canton }}, {{ estructura.distrito }}
                    </span>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="  d-flex  justify-content-center text-muted">
                    <span class="fw-semibold">Sismo del {{ fecha|date("d-m-Y H:i:s ") }} con epicentro  {{ epi }} </span>
                    <span class="badge bg-danger">M {{ magnitud |round(1)}} </span>
                </div>

            </div>
        </div>

        {# SEPARADOR VISUAL #}
        <hr class="my-4">

        {# SECCIÓN INFERIOR: IZQUIERDA (composite card) + DERECHA (grid 2×2 de tarjetas) #}
        <div class="row g-4">
            {# COLUMNA IZQUIERDA #}
            <div class="col-12 col-lg-5">
                {# Convertimos la tarjeta en una columna flex (flex-column) #}
                <div class="card h-100 border rounded p-3 d-flex flex-column">

                    {# 1. Contenedor de la imagen (Alineada estrictamente a la izquierda) #}
                    <div class="text-start mb-4">
                        {% if datos.id %}
                            <a href="{{ asset('assets/imagenes/edificios/edificio_' ~ datos.id ~ '.jpg') }}" class="glightbox">
                                <img class="img-fluid rounded shadow-sm"
                                     style="max-width: 100%; max-height: 280px; width: auto; height: auto; object-fit: contain; cursor: zoom-in;"
                                     src="{{ asset('assets/imagenes/edificios/edificio_' ~ datos.id ~ '.jpg') }}"
                                     alt="Edificio {{ datos.id }}">
                            </a>
                        {% else %}
                            <img class="img-fluid rounded shadow-sm"
                                 style="max-width: 100%; max-height: 280px; width: auto; height: auto; object-fit: contain;"
                                 src="{{ asset('assets/imagenes/default.jpg') }}"
                                 alt="Imagen no disponible">
                        {% endif %}
                    </div>

                    {# 2. Contenedor de las estaciones (Siempre al final gracias a mt-auto) #}
                    <div class="mt-auto text-start">
                        <hr class="text-muted opacity-25">
                        <h6 class="text-muted mb-3">
                            Ubicación de sensores en estructura
                        </h6>

                        {% set estaciones = datos.estaciones_edificio|split('-') %}

                        {% if estaciones is not empty %}
                            <div class="d-flex flex-wrap gap-2 justify-content-start">
                                {% for estacion in estaciones %}
                                    {#
                                    Construimos la ruta a la imagen del plano estructural.
                                    Ejemplo resultante: assets/imagenes/planos/edificio_1_HNE.jpg
                                    (Asegúrate de ajustar 'planos/' a la carpeta real que uses)
                                    #}
                                    {% set imagen_plano = asset('assets/imagenes/planos/edificio_' ~ datos.id ~ '_' ~ estacion ~ '.jpg') %}

                                    <button type="button"
                                            class="btn btn-outline-success btn-sm"
                                            onclick="openModal('{{ imagen_plano }}')"
                                            title="Ver ubicación en el plano">
                                        <i class="bi bi-geo-alt-fill"></i> {{ estacion }}
                                    </button>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-muted small mt-2">
                                No hay estaciones registradas para este edificio.
                            </div>
                        {% endif %}
                    </div>

                </div> {# /card #}
            </div>


            {# COLUMNA DERECHA: GRID 2×2 DE TARJETAS #}
            <div class="col-12 col-lg-7">
                <div class="row row-cols-1 row-cols-sm-2 g-4">
                    {% set tarjetas = [
                        { titulo: 'Formas de Onda', texto: 'PGA, Velocidad y Desplazamiento',
                            icono: 'bi bi-activity' , accion: 'abrirFormasOnda' },
                        { titulo: 'Espectros', texto: 'Aceleración, Velocidad y Desplazamiento',
                            icono: 'bi-graph-down text-warning' , accion: 'abrirEspectros' },
                        { titulo: 'Espectro de Fourier', texto: 'Texto', icono: 'bi-lightning-charge text-info' ,
                            accion: 'abrirFourier'},
                        { titulo: 'Cocientes Espectrales', texto: 'Texto', icono: 'bi-diagram-2 text-success' ,
                            accion: 'abrirCocientes'}
                    ] %}

                    {% for tarjeta in tarjetas %}
                        <div class="col">
                            <div class="card shadow-sm position-relative h-100">
                                <div class="card-body text-center">
                                    <div class="mb-3">
                                        <i class="bi {{ tarjeta.icono }} fs-2 text-primary"></i>
                                    </div>
                                    <h5 class="card-title">{{ tarjeta.titulo }}</h5>
                                    <p class="card-text">{{ tarjeta.texto }}</p>
                                    <a href="javascript:void(0);" onclick="{{ tarjeta.accion }}('{{ id }}', '{{ fecha }}', '{{ magnitud }}'
                                            , '{{ epi }}', '{{ estructura.id }}', '{{ estructura.nombre_edificio }}')" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div> {# /row inferior #}
    </div>

    <div id="myModal" class="modal">
        <!-- El contenido del modal (la imagen) -->
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-body text-center">
                    <img class="modal-content" id="img01">
                </div>
            </div>
        </div>
        <!-- <span class="close">&times;</span>-->

    </div>


{% endblock %}
