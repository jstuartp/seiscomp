{% extends '/base.html.twig' %}

{% block head_extra %}
    <meta http-equiv="refresh" content="1800">
    <style>
        /* ====== Layout general ====== */
        .lis-layout { min-height: 100vh; }

        /* Estilos utilitarios previos */
        .card-header button { text-align: left; width: 100%; }
        .badge-mag { min-width: 3.2rem; }
        .card-hover:hover { background: #f8fbff; }
    </style>
{% endblock %}

{% block body %}

    <script>

    </script>
    <div class="container-xxl my-3">

        {# FILA SUPERIOR: col 1 (izquierda) + col 2 (derecha) #}
        <div class="row g-3 align-items-stretch">
            <div class="col-12 col-lg-4">
                <div class="  d-flex  text-muted">
                    <span class="fw-semibold">Informacion edificio</span>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="  d-flex  justify-content-center text-muted">
                    <span class="fw-semibold">col 2</span>
                </div>
            </div>
        </div>

        {# SEPARADOR VISUAL #}
        <hr class="my-4">

        {# SECCIÓN INFERIOR: IZQUIERDA (composite card) + DERECHA (grid 2×2 de tarjetas) #}
        <div class="row g-4">
            {# COLUMNA IZQUIERDA #}
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="row g-3">
                            {# Subcolumna izquierda: imagen, texto breve, botones #}
                            <div class="col-12 col-md-5 d-flex flex-column">
                                {# Placeholder de imagen 320x200 #}
                                <svg class="bd-placeholder-img w-100 rounded border" style="aspect-ratio: 16/10;" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Imagen"
                                     preserveAspectRatio="xMidYMid slice" focusable="false">
                                    <title>imagen</title>
                                    <rect width="100%" height="100%" fill="#e9ecef"></rect>
                                    <text x="50%" y="50%" fill="#6c757d" dy=".3em" text-anchor="middle">imagen</text>
                                </svg>

                                <p class="mt-3 mb-2 small text-muted flex-shrink-0">
                                    texto
                                </p>

                                <div class="mt-auto d-flex gap-2">
                                    <a href="#" class="btn btn-primary btn-sm">boton</a>
                                    <a href="#" class="btn btn-outline-secondary btn-sm">boton</a>
                                </div>
                            </div>

                            {# Subcolumna derecha: área de texto amplia #}
                            <div class="col-12 col-md-7">
                                <div class="h-100 border rounded bg-light p-3 d-flex align-items-center justify-content-center text-muted">
                                    <span class="text-center">texto</span>
                                </div>
                            </div>
                        </div> {# /row #}
                    </div> {# /card-body #}
                </div> {# /card #}
            </div>

            {# COLUMNA DERECHA: GRID 2×2 DE TARJETAS #}
            <div class="col-12 col-lg-7">
                <div class="row row-cols-1 row-cols-sm-2 g-4">
                    <div class="col">
                        <div class="card h-100 border rounded d-flex align-items-center justify-content-center p-4">
                            <div class="text-muted">tarjeta 1</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border rounded d-flex align-items-center justify-content-center p-4">
                            <div class="text-muted">tarjeta 2</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border rounded d-flex align-items-center justify-content-center p-4">
                            <div class="text-muted">tarjeta 3</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border rounded d-flex align-items-center justify-content-center p-4">
                            <div class="text-muted">tarjeta 4</div>
                        </div>
                    </div>
                </div>
            </div>
        </div> {# /row inferior #}

    </div>


{% endblock %}
