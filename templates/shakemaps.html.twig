{% extends '/base.html.twig' %}
 {% block scripts %}
    {{ parent() }}
<style>

    .leyenda-jma {
        background-color: rgba(220, 225, 228, 0.9); /* Fondo gris claro semitransparente */
        padding: 8px 12px;
        border-radius: 4px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.4);
        font-family: Arial, sans-serif;
        color: #333;
        width: 250px;
        line-height: 1.2;
    }

    .leyenda-jma-titulo {
        font-weight: bold;
        font-size: 11px;
        text-align: center;
        margin-bottom: 5px;
        letter-spacing: 0.3px;
        color: #222;
    }

    .leyenda-jma-barra {
        height: 12px;
        width: 100%;
        border: 1px solid #333;
        /* Los mismos 8 colores exactos usados en tu script de Python */
        background: linear-gradient(to right,
        #ffffff 0%,
        #d2d2d2 11.1%,
        #0032ff 22.2%,
        #00faff 33.3%,
        #0bc200 44.4%,
        #ffff00 55.5%,
        #f77a00 66.6%,
        #f40001 77.7%,
        #a90000 88.8%,
        #640064 100%
        );
    }

    .leyenda-jma-ticks {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-top: 0px;
    }

    /* Crea las pequeñas líneas verticales sobre cada número */
    .leyenda-jma-ticks span {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 10px;
    }

    .leyenda-jma-ticks span::before {
        content: '';
        height: 4px;
        width: 1px;
        background-color: #333;
        margin-bottom: 2px;
    }

    .leyenda-jma-etiquetas {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        margin-top: 4px;
        padding: 0 15px; /* Ajusta la posición de los textos Débil, Moderado, Fuerte */
    }
</style>
{% endblock %}
{% block body %}
    <div class="container-fluid">
        <div class="row">
            <br><br>
        </div>

        {# Encabezado #}
        <div class="row">
            <div class="col-sm-8">
                <h2 class="mb-4">
                    {% block page_title %}
                        JMA Interpolado: Sismo del <strong>{{ fecha|date("d-m-Y H:i:s ") }} </strong>(UTC)
                        <span class="badge bg-danger">M {{ magnitud |round(1)}} </span>
                    {% endblock %}
                </h2>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>
        </div>

        {# Mapa (Ocupando todo el ancho) #}
        <div class="row h-100">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <div id="visor_sismico" style="width: 100%; height: 700px; border: 1px solid #ccc;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block scriptspie %}
    {{ parent() }}
{% endblock %}
{% block endscrips %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {








            // 1. Definimos EXACTAMENTE las mismas coordenadas que usamos en Python
            var limitesCostaRica = [[7.99, -86.1], [11.29, -82.5]];

// 2. Inicializar el mapa con restricciones
            var mapa = L.map('visor_sismico', {
                zoomControl: true,           // Muestra los botones de +/-
                minZoom: 7,                  // Evita que el usuario aleje demasiado la vista
                maxBounds: limitesCostaRica, // "Encierra" la navegación en este cuadro
                maxBoundsViscosity: 1.0      // Efecto rebote si intentan arrastrar fuera de Costa Rica
            });

// 3. Mapa base recomendado (CartoDB Positron - Escala de grises clara)
// Este mapa hace que los colores de la escala JMA resalten muchísimo más
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(mapa);

// 4. Agregar tu ShakeMap
            var urlImagen = "{{ asset('assets/waves/' ~ id_evento ~ '/'~ id_evento ~'_interpolado.png') }}";

            var capaShakeMap = L.imageOverlay(urlImagen, limitesCostaRica, {
                opacity: 0.75,      // 75% es ideal para ver los nombres de ciudades debajo del color
                interactive: false  // Permite hacer clic "a través" de la imagen
            }).addTo(mapa);

// 5. Forzar al mapa a encuadrar la imagen completa al cargar
            mapa.fitBounds(limitesCostaRica);

            const starIcon = L.divIcon({
                html: ' <img src="{{ asset('assets/imagenes/Estrella_roja.png')}}" alt="Estrella" style="width:50%;"> ',
                className: '',
                iconSize: [80, 80],
                iconAnchor: [30, 30]
            });

            // Agregar el marcador con estrella
            L.marker([ {{ epi_lat }}, {{ epi_long }}], {icon: starIcon})
                .addTo(mapa)
                .bindPopup('Epicentro<br> Mag: {{ magnitud | round(1) }}');

// 1. Crear el control personalizado anclado abajo a la izquierda
            var leyendaJMA = L.control({ position: 'bottomleft' });

// 2. Definir la estructura HTML que irá dentro de ese control
            leyendaJMA.onAdd = function (map) {
                var div = L.DomUtil.create('div', 'leyenda-jma');

                div.innerHTML = `
        <div class="leyenda-jma-titulo">INTENSIDAD SISMICA ESCALA JMA</div>
        <div class="leyenda-jma-barra"></div>
        <div class="leyenda-jma-ticks">
            <span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span>
        </div>
        <div class="leyenda-jma-etiquetas">
            <span style="margin-left: 5px;">Débil</span>
            <span style="margin-left: 5px;">Moderado</span>
            <span style="margin-right: 5px;">Fuerte</span>
        </div>
    `;

                return div;
            };

// 3. Agregar la leyenda al mapa (Asegúrate de que 'mapa' sea el nombre de tu variable)
            leyendaJMA.addTo(mapa);

        });
    </script>
{% endblock %}