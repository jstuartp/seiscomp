{% extends '/base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <br><br>
        </div>

        {# Encabezado #}
        <div class="row">
            <div class="col-sm-8">
                <h2 class="mb-4">
                    {% block page_title %}
                        ShakeMap: Sismo del <strong>{{ fecha|date("d-m-Y H:i:s ") }} </strong>(UTC)
                        <span class="badge bg-danger">M {{ magnitud |round(1)}} </span>
                    {% endblock %}
                </h2>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>
        </div>

        {# Mapa (Ocupando todo el ancho) #}
        <div class="row h-100">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body">
                        <div id="map" style="width: 100%; height: 75vh; border: 1px solid #ccc;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block scriptspie %}
    {{ parent() }}
{% endblock %}
{% block endscrips %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const starIcon = L.divIcon({
                html: ' <img src="{{ asset('assets/imagenes/Estrella_roja.png')}}" alt="Estrella" style="width:50%;"> ',
                className: '',
                iconSize: [80, 80],
                iconAnchor: [30, 30]
            });

            // 1. Inicialización del Mapa
            var map = L.map('map').setView([{{ epi_lat }}, {{ epi_long }}], 8);

            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ, TomTom, Intermap, iPC, USGS, FAO, NPS, NRCAN, GeoBase, Kadaster NL, Ordnance Survey, Esri Japan, METI, Esri China (Hong Kong), and the GIS User Community'
            }).addTo(map);

            // 2. Función de Colores para el PGA (Mantenemos tu lógica original)
            function getColor(d) {
                return d > 6.5  ? '#a90000' :
                    d > 6.0  ? '#f40001' :
                        d > 5.5  ? '#f77a00' :
                            d > 5.0  ? '#ffff00' :
                                d > 4.5   ? '#0bc200' :
                                    d > 3.5   ? '#00faff' :
                                        d > 2.5   ? '#0032ff' :
                                            d > 1.5   ? '#d2d2d2' :
                                                d > 0.5   ? 'rgba(255,255,255,0)' :
                                        'rgba(255,255,255,0)';
            }

            // Agregar el marcador con estrella
            L.marker([ {{ epi_lat }}, {{ epi_long }}], {icon: starIcon})
                .addTo(map)
                .bindPopup('Epicentro<br> Mag: {{ magnitud | round(1) }}');

            // 3. CAPA SHAKEMAP (GeoJSON inyectado desde el Controller)
            // Se agrega primero para que quede debajo de los marcadores
            const shakeMapData = {{ shakemap_json|raw }};

            L.geoJson(shakeMapData, {
                style: function(feature) {
                    return {
                        fillColor: getColor(feature.properties.pga),
                        weight: 0.001, // Borde muy fino para los rectángulos de la malla
                        opacity: 1,
                        color: 'white',
                        fillOpacity: 0.4 // Transparencia para ver el mapa base
                    };
                }
            }).addTo(map);

            // 4. Marcador del Epicentro (Estrella)


            // 5. Marcadores de las Estaciones (Triángulos)
            {% for item in pgaData %}
            var stationLat = parseFloat('{{ item.lat }}');
            var stationLon = parseFloat('{{ item.lon }}');
            var pgaValue = parseFloat('{{ item.jma }}');
            var stationName = '{{ item.estacion }}';
            var colorMarker = getColor(pgaValue);

            var svgIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 100 100">
                    <polygon points="50,15 90,85 10,85" style="fill:${colorMarker};stroke:black;stroke-width:3" />
                </svg>`;
            //var customIcon = triangleIcon(color, /* tamaño px */ 18, /* fillOpacity */ 0.5, /* stroke */ '#333', /* strokeWidth */ 2);

            var customIcon = L.divIcon({
                className: 'custom-div-icon',
                html: svgIcon,
                iconSize: [10, 10],
                iconAnchor: [5, 5]
            });

           // L.marker([stationLat, stationLon], { icon: customIcon }).addTo(map)
           //     .bindPopup("<b>Estación: " + stationName + "</b><br>PGA: " + pgaValue + " cm/s²");
            {% endfor %}

            // Nueva función para dibujar rectángulos en lugar de triángulos
            function legendRectangle(color) {
                const s = 16;
                // Usamos x="1" y="1" y restamos 2 al ancho/alto para que el borde (stroke) no se corte
                return `
        <svg xmlns="http://www.w3.org/2000/svg" width="${s}" height="${s}" viewBox="0 0 ${s} ${s}"
             style="vertical-align: middle; margin-right: 6px;">
          <rect x="1" y="1" width="${s-2}" height="${s-2}"
                fill="${color}" fill-opacity="0.5"
                stroke="#333" stroke-width="1.5"/>
        </svg>`;
            }

// Definición de rangos en el mismo orden que el getColor (Escala JMA)
            const legendItems = [
                { label: '7',  color: '#640064' },
                { label: '6+', color: '#a90000' },
                { label: '6-', color: '#f40001' },
                { label: '5+', color: '#f77a00' },
                { label: '5-', color: '#ffff00' },
                { label: '4',  color: '#0bc200' },
                { label: '3',  color: '#00faff' },
                { label: '2',  color: '#0032ff' },
                { label: '1',  color: '#d2d2d2' },
            ];

// Control de Leaflet para la leyenda
            const legend = L.control({ position: 'topright' });

            legend.onAdd = function () {
                const div = L.DomUtil.create('div', 'info legend');
                div.innerHTML = '<div class="legend-title" style="margin-bottom: 5px;"><strong>Escala JMA</strong></div>';

                legendItems.forEach(item => {
                    div.innerHTML += `
            <div class="legend-item" style="margin-bottom: 3px;">
                ${legendRectangle(item.color)}<span>${item.label}</span>
            </div>`;
                });

                return div;
            };


            legend.addTo(map);
        });
    </script>
{% endblock %}