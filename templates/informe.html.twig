{% extends 'base.html.twig' %}

{% block body %}

    <script>
        // Función unificada para manejar la navegación normal y móvil con envío condicional de datos
        function procesarNavegacion(rutaNormal, rutaMovil, id, fecha, mag, lat, long,profundidad, epi) {
            // Detección automática de dispositivo móvil (sin intervención del usuario)
            const esMovil = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth <= 768;

            var theForm = document.createElement('form');
            // Decide la ruta final
            theForm.action = esMovil ? rutaMovil : rutaNormal;
            theForm.method = 'get';

            // El 'id' se envía SIEMPRE, sin importar el dispositivo
            let inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = 'id';
            inputId.value = id;
            theForm.appendChild(inputId);

            // Si NO es móvil, adjuntamos el resto de los datos
            if (!esMovil) {
                const parametrosExtra = {
                    'fecha': fecha,
                    'mag': mag,
                    'lat': lat,
                    'long': long,
                    'profundidad': profundidad,
                    'epi': epi
                };

                for (const [key, value] of Object.entries(parametrosExtra)) {
                    let input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = value;
                    theForm.appendChild(input);
                }
                theForm.method = 'post';
            }

            document.getElementById('hidden_form_container').appendChild(theForm);
            theForm.submit();
        }
    </script>

    {% set ruta_actual = app.request.attributes.get('_route') %}

    <div class="container-fluid h-100">
        {# Encabezado #}
        <div class="row mt-4 mb-3">
            <div class="col-sm-8">
                <h2 class="mb-2">{% block page_title %}
                    Sismo
                    del <strong>{{ fecha|date("d-m-Y") }}</strong> <span class="badge bg-danger">M {{ magnitud |
                        round(1) }} </span> </h2>
                <h3>
                    Hora: {{ fecha|date("H:i:s ") }}(UTC) -- {{ fecha|date('H:i:s', 'America/Costa_Rica') }} (Local)
                    {% endblock %}
                </h3>

                <h4 class="text-muted">{{ epi }}</h4>
                <h4 class="text-muted">Profundidad: {{ profundidad|round(1) }} km</h4>
            </div>
            <div class="col-sm-4 text-end">
                <a href="{{ path('homepage') }}" class="btn btn-success">Inicio</a>
            </div>

        </div>

        {# Contenido principal dividido en 2 columnas #}
        <div class="row">

            {# COLUMNA IZQUIERDA: Tarjetas (Ocupa 8 de 12 columnas en pantallas grandes) #}
            <div class="col-lg-8 col-md-12 mb-4">
                <div class="row g-3">

                    {% block content %}
                        {% set habilitada = (informe|default(0)) == 1 %}

                        {# 1. Epicentro #}
                        <div class="col-sm-6 col-md-4">
                            <div class="card shadow-sm position-relative h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-geo-alt-fill fs-2 text-primary"></i></div>
                                    <h5 class="card-title">Epicentro</h5>
                                    <p class="card-text small mb-4">Mapa de ubicación y lugares cercanos</p>

                                    <a href="javascript:void(0);"
                                       onclick="procesarNavegacion('{{ path('epicentro') }}', '{{ path('epicentro') }}',
                                               '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}','{{ lat|e('js') }}',
                                               '{{ long|e('js') }}','{{ profundidad|e('js') }}','{{ epi|e('js') }}')"
                                       class="stretched-link"></a>
                                </div>
                            </div>
                        </div>

                        {# 2. Aceleración Máxima #}
                        <div class="col-sm-6 col-md-4">
                            <div id="card-aceleracion" class="card shadow-sm position-relative h-100 {{ habilitada ? '' : 'opacity-50' }}">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-speedometer2 fs-2 text-primary"></i></div>
                                    <h5 class="card-title">Valores Máximos</h5>
                                    <p class="card-text small mb-4">Mapa interactivo y formas de Onda</p>

                                    <a class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                            {% if habilitada %} href="javascript:void(0);"
                                        onclick="procesarNavegacion('{{ path('pga') }}', '{{ path('pga_movil') }}',
                                                '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ profundidad|e('js') }}','{{ epi|e('js') }}')"
                                    {% else %} href="#" tabindex="-1" onclick="return false;"
                                            {% endif %}></a>
                                </div>
                            </div>
                        </div>

                        {# 3. Intensidad JMA #}
                        <div class="col-sm-6 col-md-4">
                            <div id="card-jma" class="card shadow-sm position-relative h-100 {{ habilitada ? '' : 'opacity-50' }}">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-archive fs-2 text-primary"></i></div>
                                    <h5 class="card-title">Intensidad JMA</h5>
                                    <p class="card-text small mb-4">Distribución de valores máximos</p>

                                    <a class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                            {% if habilitada %} href="javascript:void(0);"
                                        onclick="procesarNavegacion('{{ path('jma') }}', '{{ path('jma_movil') }}',
                                                '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ profundidad|e('js') }}','{{ epi|e('js') }}')"
                                    {% else %} href="#" tabindex="-1" onclick="return false;"
                                            {% endif %}></a>
                                </div>
                            </div>
                        </div>

                        {# 4. Edificios #}
                        <div class="col-sm-6 col-md-4 d-none">
                            <div id="card-edificios" class="card shadow-sm position-relative h-100 {{ habilitada ? '' : 'opacity-50' }}">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-building fs-2 text-primary"></i></div>
                                    <h5 class="card-title">Edificios</h5>
                                    <p class="card-text small mb-4">Impacto del evento en edificaciones</p>

                                    <a class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                            {% if habilitada %} href="javascript:void(0);"
                                        onclick="procesarNavegacion('{{ path('app_estructuras') }}', 'RUTA_EDIFICIOS_MOVIL',
                                                '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ profundidad|e('js') }}','{{ epi|e('js') }}')"
                                    {% else %} href="#" tabindex="-1" onclick="return false;"
                                            {% endif %}></a>
                                </div>
                            </div>
                        </div>

                        {# 5. Espectros #}
                        <div class="col-sm-6 col-md-4">
                            <div id="card-espectros" class="card shadow-sm position-relative h-100 {{ habilitada ? '' : 'opacity-50' }}">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-activity fs-2 text-primary"></i></div>
                                    <h5 class="card-title">Espectros</h5>
                                    <p class="card-text small mb-4">Espectros de pseudoaceleración calculados por estación</p>

                                    <a class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                            {% if habilitada %} href="javascript:void(0);"
                                        onclick="procesarNavegacion('{{ path('espectros') }}', '{{ path('espectros_movil') }}',
                                                '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}','{{ lat|e('js') }}',
                                                '{{ long|e('js') }}','{{ profundidad|e('js') }}','{{ epi|e('js') }}')"
                                    {% else %} href="#" tabindex="-1" onclick="return false;"
                                            {% endif %}></a>
                                </div>
                            </div>
                        </div>

                        {# 6. Shakemaps #}
                        <div class="col-sm-6 col-md-4 ">
                            <div id="card-shakemaps" class="card shadow-sm position-relative h-100 {{ habilitada ? '' : 'opacity-50' }}">
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-3"><i class="bi bi-map fs-2 text-primary"></i></div>
                                    <h5 class="card-title">JMA Interpolado</h5>
                                    <p class="card-text small mb-4">JMA Con Interpolaci&oacute;n</p>

                                    <a class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                            {% if habilitada %} href="javascript:void(0);"
                                        onclick="procesarNavegacion('{{ path('shakemaps') }}', 'RUTA_SHAKEMAPS_MOVIL',
                                                '{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                    {% else %} href="#" tabindex="-1" onclick="return false;"
                                            {% endif %}></a>
                                </div>
                            </div>
                        </div>

                    {% endblock %}
                </div>
            </div>

            {# COLUMNA DERECHA: Mapa Estático (Ocupa 4 de 12 columnas) #}
            <div class="col-lg-4 col-md-12">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-body p-0">
                        <div id="map" style="width: 100%; height: 420px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"></div>
                    </div>
                </div>
            </div>

        </div>

        <div id="hidden_form_container" style="display:none;"></div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // Configuración de mapa estático (sin interacciones)
            var map = L.map('map', {
                zoomControl: false,
                dragging: false,
                touchZoom: false,
                scrollWheelZoom: false,
                doubleClickZoom: false,
                boxZoom: false,
                keyboard: false
            }).setView([0, 0], 2);

            let bounds = L.latLngBounds([8.03, -85.95], [11.22, -82.55]);
            map.fitBounds(bounds);

            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'LIS-UCR'
            }).addTo(map);

            // Estrella del epicentro
            const starIcon = L.divIcon({
                html: '<img src="{{ asset('assets/imagenes/Estrella_roja.png')}}" alt="Estrella" style="width:30px;">',
                className: '',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });
            L.marker([{{ lat }}, {{ long }}], {icon: starIcon, zIndexOffset:900000}).addTo(map);

            // Verificar si tenemos los datos necesarios (previene errores si el Controller aún no los envía)
            {% if datos is defined and datos is not empty %}
            // Funciones de estilo
            function getIndex(valor) {
                if (valor > 60) return 9*2000;
                if (valor > 40) return 8*2000;
                if (valor > 20) return 7*2000;
                if (valor > 10) return 6*2000;
                if (valor > 5) return 5*2000;
                if (valor > 1) return 4*2000;
                return 3*2000;
            }

            function getColor(valor) {
                if (valor > 60) return "#cc0000";
                if (valor > 40) return '#cc5200';
                if (valor > 20) return '#cc8b00';
                if (valor > 10) return '#ccaa00';
                if (valor > 5) return '#88cc00';
                if (valor > 1) return '#00cc03';
                return '#0058cc';
            }

            function triangleIcon(color) {
                const s = 14;
                const points = `${s/2},2 ${s-2},${s-2} 2,${s-2}`;
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${s}" height="${s}" viewBox="0 0 ${s} ${s}">
                                    <polygon points="${points}" fill="${color}" fill-opacity="0.8" stroke="#333" stroke-width="1" />
                                 </svg>`;
                return L.divIcon({
                    html: svg, className: 'triangle-icon', iconSize: [s, s], iconAnchor: [s/2, s/2]
                });
            }

            var puntos = [
                {% for dato in datos %}
                { lat: {{ dato.latitud }}, lng: {{ dato.longitud }}, max: {{ dato.maximo }} }
                {% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            puntos.forEach(function (punto) {
                L.marker([punto.lat, punto.lng], {
                    icon: triangleIcon(getColor(punto.max)),
                    zIndexOffset: getIndex(punto.max)
                }).addTo(map);
            });
            {% else %}
            //document.getElementById('map').innerHTML = "<div class='p-3 text-center text-muted'>Cargando mapa...<br><small>(Requiere enviar variable 'datos' desde el controlador)</small></div>";
            {% endif %}
        });
    </script>
{% endblock %}