    </script>

    {% set ruta_actual = app.request.attributes.get('_route') %}
    <div class="container-fluid h-100" xmlns="http://www.w3.org/1999/html">



            <div class="row h-100 flex-nowrap">
                {# Contenido principal #}

                <div class="row h-100">

                    <div class="row">
                        <br><br>
                        <div class="col">

                        </div>
                    </div>
                        <div class="row">
                            <div class="col-sm-8">
                                <h2 class="mb-4">{% block page_title %}
                                    Sismo del <strong>{{ fecha|date("d-m-Y H:i:s ") }}</strong>(UTC)
                                    <span class="badge bg-danger">M {{ magnitud | round(1)}} </span>{% endblock %}
                                </h2>
                            </div>
                            <div class="col-sm-4 text-end">
                                <a href="{{ path('homepage') }}" class="btn btn-success">
                                    Inicio
                                </a>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-8">
                                <h3 class="mb-4">
                                        {{ epi }}
                                </h3>
                            </div>
                        </div>
                    <main class="col-9  p-4 overflow-auto mt-3">

                        <div class="row g-4">
                            {% block content %}
                                <div class="col-md-4">
                                    <div class="card shadow-sm position-relative">
                                        <div class="card-body" >
                                            <div class="mb-3">
                                                <i class="bi bi-geo-alt-fill fs-2 text-primary"></i>
                                            </div>
                                            <h5 class="card-title">Epicentro</h5>
                                            <p class="card-text">Mapa de ubicaci&oacute;n y lugares cercanos</p>
                                            <a href="javascript:void(0);"
                                               onclick="enviaEpicentro('{{ id }}','{{ fecha }}','{{ magnitud }}',
                                                       '{{ lat }}','{{ long }}','{{ epi|e('js') }}')"
                                               class="stretched-link"></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    {# Determina si la card debe estar habilitada según "informe" #}
                                    {% set habilitada = (informe|default(0)) == 1 %}

                                    {# Card: Mapa de Aceleración / Principales valores de aceleración #}
                                    <div
                                            id="card-aceleracion"
                                            class="card shadow-sm position-relative {{ habilitada ? '' : 'opacity-50' }}"
                                            aria-disabled="{{ habilitada ? 'false' : 'true' }}"
                                    >
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <i class="bi bi-speedometer2 fs-2 text-primary" aria-hidden="true"></i>
                                            </div>

                                            <h5 class="card-title">Aceleración M&aacute;xima</h5>
                                            <p class="card-text">Mapa interactivo y formas de Onda</p>

                                            {# Enlace/activador: sólo permite acción real cuando está habilitada #}
                                            <a
                                                    id="card-aceleracion-link"
                                                    class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                                    {% if habilitada %}
                                                        href="javascript:void(0);"
                                                        onclick="enviaDatos('{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                                    {% else %}
                                                        href="#"
                                                        tabindex="-1"
                                                        aria-disabled="true"
                                                        onclick="return false;"
                                                    {% endif %}
                                            ></a>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    {# Determina si la card debe estar habilitada según "informe" #}
                                    {% set habilitada = (informe|default(0)) == 1 %}

                                    {# Card: intensidad JMA #}
                                    <div
                                            id="card-jma"
                                            class="card shadow-sm position-relative {{ habilitada ? '' : 'opacity-50' }}"
                                            aria-disabled="{{ habilitada ? 'false' : 'true' }}"
                                    >
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <i class="bi bi-archive fs-2 text-primary" aria-hidden="true"></i>
                                            </div>

                                            <h5 class="card-title">Intensidad JMA</h5>
                                            <p class="card-text">Distribuci&oacute;n de valores m&aacute;ximos</p>

                                            {# Enlace/activador: sólo permite acción real cuando está habilitada #}
                                            <a
                                                    id="card-intensidad-link"
                                                    class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                                    {% if habilitada %}
                                                        href="javascript:void(0);"
                                                        onclick="intensidadJma('{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                                    {% else %}
                                                        href="#"
                                                        tabindex="-1"
                                                        aria-disabled="true"
                                                        onclick="return false;"
                                                    {% endif %}
                                            ></a>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    {# Determina si la card debe estar habilitada según "informe" #}
                                    {% set habilitada = (informe|default(0)) == 1 %}

                                    {# Card: Edificios #}
                                    <div
                                            id="card-edificios"
                                            class="card shadow-sm position-relative {{ habilitada ? '' : 'opacity-50' }}"
                                            aria-disabled="{{ habilitada ? 'false' : 'true' }}"
                                    >
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <i class="bi bi-building fs-2 text-primary" aria-hidden="true"></i>
                                            </div>

                                            <h5 class="card-title">Edificios</h5>
                                            <p class="card-text">Impacto del evento en edificaciones</p>

                                            {# Enlace/activador: sólo permite acción real cuando está habilitada #}
                                            <a
                                                    id="card-intensidad-link"
                                                    class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                                    {% if habilitada %}
                                                        href="javascript:void(0);"
                                                        onclick="edificios('{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                                    {% else %}
                                                        href="#"
                                                        tabindex="-1"
                                                        aria-disabled="true"
                                                        onclick="return false;"
                                                    {% endif %}
                                            ></a>
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    {# Determina si la card debe estar habilitada según "informe" #}
                                    {% set habilitada = (informe|default(0)) == 1 %}

                                    {# Card: Espectros #}
                                    <div
                                            id="card-espectros"
                                            class="card shadow-sm position-relative {{ habilitada ? '' : 'opacity-50' }}"
                                            aria-disabled="{{ habilitada ? 'false' : 'true' }}"
                                    >
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <i class="bi bi-activity fs-2 text-primary" aria-hidden="true"></i>
                                            </div>

                                            <h5 class="card-title">Espectros</h5>
                                            <p class="card-text">Espectros registrados por estaci&oacute;n</p>

                                            {# Enlace/activador: sólo permite acción real cuando está habilitada #}
                                            <a
                                                    id="card-intensidad-link"
                                                    class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                                    {% if habilitada %}
                                                        href="javascript:void(0);"
                                                        onclick="espectros('{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                                    {% else %}
                                                        href="#"
                                                        tabindex="-1"
                                                        aria-disabled="true"
                                                        onclick="return false;"
                                                    {% endif %}
                                            ></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    {# Determina si la card debe estar habilitada según "informe" #}
                                    {% set habilitada = (informe|default(0)) == 1 %}

                                    {# Card: Shakemaps #}
                                    <div
                                            id="card-shakemaps"
                                            class="card shadow-sm position-relative {{ habilitada ? '' : 'opacity-50' }}"
                                            aria-disabled="{{ habilitada ? 'false' : 'true' }}"
                                    >
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <i class="bi bi-map fs-2 text-primary" aria-hidden="true"></i>
                                            </div>

                                            <h5 class="card-title">Shakemaps</h5>
                                            <p class="card-text">Shakemaps para aceleraci&oacute;n e intensidad</p>

                                            {# Enlace/activador: sólo permite acción real cuando está habilitada #}
                                            <a
                                                    id="card-intensidad-link"
                                                    class="stretched-link {{ habilitada ? '' : 'pe-none disabled' }}"
                                                    {% if habilitada %}
                                                        href="javascript:void(0);"
                                                        onclick="shakemaps('{{ id|e('js') }}','{{ fecha|e('js') }}','{{ magnitud|e('js') }}',
                                                                '{{ lat|e('js') }}','{{ long|e('js') }}','{{ epi|e('js') }}')"
                                                    {% else %}
                                                        href="#"
                                                        tabindex="-1"
                                                        aria-disabled="true"
                                                        onclick="return false;"
                                                    {% endif %}
                                            ></a>
                                        </div>
                                    </div>

                                </div>
                            {% endblock %}
                        </div>
                    </main>
                </div>
            </div>
        <div id="hidden_form_container" style="display:none;"></div>

    </div>


{% endblock %}