{% extends 'base_movil.html.twig' %}

{% block page_title %}Intensidades JMA - M {{ magnitud|round(1) }}{% endblock %}

{% block body %}
    <div class="container-fluid p-2" style="max-width: 600px; margin: 0 auto;">

        <div class="text-center mb-3 mt-2">
            <h4 class="mb-1 fw-bold">Intensidad JMA (M {{ magnitud|round(1) }})</h4>
            <div class="text-muted small">{{ fecha|date("d-m-Y H:i:s") }} UTC</div>
            <div class="mt-2 small fw-semibold text-primary">{{ epi }}</div>
        </div>

        <div class="card shadow-sm mb-3 border-0">
            <div id="map" style="width: 100%; height: 350px; border-radius: 8px;"></div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-2">
                <h6 class="mb-0 text-center"><i class="bi bi-list-stars"></i> Intensidades por Estación (top 5)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0 text-center" style="font-size: 13px;">
                        <thead class="table-light">
                        <tr>
                            <th>Estación</th>
                            <th>Intensidad JMA</th>
                            <th>Sostenida (cm/s&sup2)</th>
                            <th>Aceleraci&oacute;n M&aacute;xima (cm/s&sup2)</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for dato in top5 %}
                            <tr>
                                <td class="text-start ps-2">
                                    <span class="fw-bold">{{ dato.estacion }}</span><br>
                                </td>
                                <td class="align-middle">
                                    {{ dato.jma }}
                                </td>
                                <td>{{ dato.threshold_a0 | round(2)}}</td>
                                <td>{{ dato.maximo | round(2)}}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 mb-4">
            <a href="{{ path('pga_movil', {'id': id}) }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-house-door"></i> Volver al Inicio
            </a>
        </div>
    </div>

    {# Estilos específicos para la leyenda del mapa en móvil #}
    <style>
        .info.legend {
            background: white;
            padding: 5px;
            border-radius: 5px;
            box-shadow: 0 0 5px rgba(0,0,0,0.2);
            font-size: 10px;
            line-height: 12px;
        }
        .legend-item { display: flex; align-items: center; margin-bottom: 2px; }
        .legend-item svg { margin-right: 4px; }
    </style>

    {# Scripts para el mapa #}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var map = L.map('map', {
                zoomControl: false,
                dragging: false,
                touchZoom: false,
                scrollWheelZoom: false,
                doubleClickZoom: false,
                boxZoom: false,
                keyboard: false
            }).setView([0, 0], 2);

            let bounds = L.latLngBounds([8.03, -85.95], [11.22, -82.55]);
            map.fitBounds(bounds);

            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                attribution: '&copy; LIS-UCR'
            }).addTo(map);

            // Icono para el epicentro (Estrella)
            var starIcon = L.divIcon({
                html: '<i class="bi bi-star-fill" style="color: #ff0000; font-size: 20px; -webkit-text-stroke: 1px black;"></i>',
                className: 'custom-div-icon',
                iconSize: [20, 20],
                iconAnchor: [10, 10]
            });


            // Función para dibujar los triángulos de intensidad
            function triangleIcon(color) {
                const s = 16;
                const points = `${s/2},2 ${s-2},${s-2} 2,${s-2}`;
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${s}" height="${s}" viewBox="0 0 ${s} ${s}">
                                <polygon points="${points}" fill="${color}" fill-opacity="0.9" stroke="#333" stroke-width="1" />
                             </svg>`;
                return L.divIcon({
                    html: svg, className: 'triangle-icon', iconSize: [s, s], iconAnchor: [s/2, s/2]
                });
            }

            //Funcion para alterar el indice de los triangulos
            //escribe los mas intesos sobre los menos
            function getIndex(valor) {

                if (valor < 0.5) return 0;   // Medio
                else if (valor < 1.5) return 1 * 2000;   // Medio
                else if (valor < 2.5) return 2 *2000;   // Medio
                else if (valor < 3.5) return 3*2000;   // Medio
                else if (valor < 4.5) return 4*2000;   // Medio
                else if (valor < 5.0 ) return 5*2000;   // Medio
                else if (valor < 5.5 ) return 6*2000;   // Medio
                else if (valor < 6.0 ) return 7*2000;   // Medio
                else if (valor < 6.5 ) return 8*2000;   // Medio
                else return 9*2000;                   // Bajo
            }

            function getColor(valor) {

                if (valor < 0.5) return '#ffffff';   // Medio
                else if (valor < 1.5) return '#d2d2d2';   // Medio
                else if (valor < 2.5) return '#0032ff';   // Medio
                else if (valor < 3.5) return '#00faff';   // Medio
                else if (valor < 4.5) return '#0bc200';   // Medio
                else if (valor < 5.0 ) return '#ffff00';   // Medio
                else if (valor < 5.5 ) return '#f77a00';   // Medio
                else if (valor < 6.0 ) return '#f40001';   // Medio
                else if (valor < 6.5 ) return '#a90000';   // Medio
                else return '#640064';                   // Bajo
            }

            // Renderizar estaciones
            var puntos = [
                {% for dato in datos %}
                {
                    lat: {{ dato.lat }}, lng: {{ dato.lon }}, max: {{ dato.truncated }},
                    datos: `Estaci&oacute;n: {{ dato.estacion }} <br>
                            JMA: {{ dato.jma }} <br>`
                }
                {% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            puntos.forEach(function (punto) {
                const color = getColor(punto.max);
                const icono = triangleIcon(color, /* tamaño px */ 10, /* fillOpacity */ 10, /* stroke */ '#333', /* strokeWidth */ 2);

                L.marker([punto.lat, punto.lng], {icon: icono, zIndexOffset: getIndex(punto.max)})
                    .addTo(map)
                    .bindPopup(punto.datos);
            });

            //Estrella para marcar el epicentro
            L.marker([{{ epi_lat }}, {{ epi_long }}], {icon: starIcon, zIndexOffset:50000}).addTo(map).bindPopup("Epicentro");

            // Leyenda JMA (Compacta)
            const legend = L.control({ position: 'bottomleft' });
            legend.onAdd = function () {
                const div = L.DomUtil.create('div', 'info legend');
                const items = [
                    { label: '7',  color: '#640064' },
                    { label: '6+', color: '#a90000' },
                    { label: '6-', color: '#f40001' },
                    { label: '5+', color: '#f77a00' },
                    { label: '5-', color: '#ffff00' },
                    { label: '4',  color: '#0bc200' },
                    { label: '3',  color: '#00faff' },
                    { label: '2',  color: '#0032ff' },
                    { label: '1',  color: '#d2d2d2' },
                    { label: '0',  color: '#ffffff' }
                ];
                div.innerHTML = '<b>Escala JMA</b><br>';
                items.forEach(i => {
                    div.innerHTML += `<div class="legend-item"><svg width="10" height="10"><polygon points="5,1 9,9 1,9" fill="${i.color}" stroke="#000"/></svg> ${i.label}</div>`;
                });
                return div;
            };
            legend.addTo(map);
        });
    </script>
{% endblock %}